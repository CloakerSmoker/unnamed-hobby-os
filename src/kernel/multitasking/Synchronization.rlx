    class Semaphore derives INew {
        i8* Name

        WaitQueue* Waiters
        i32 Value

        define void New(i8* Name, i32 InitialValue) {
            this->Name := Name
            this->Waiters := SchedulerRegisterWaitQueue(Name)

            this->Value := InitialValue

            ALL_SEMAPHORES->Push(this)
        }

        define void Free() {
            ALL_SEMAPHORES->RemoveValue(this)
            
            SchedulerUnregisterWaitQueue(this->Waiters)
            this->Delete()
        }

        define i8 Wait(i32 Value, i32 TimeoutMS) {
            DisableInterrupts()

            while (this->Value < Value) {
                WaitResult Result := SchedulerWait(this->Waiters, TimeoutMS)

                if (Result = WaitResult::Timeout) {
                    EnableInterrupts()
                    return false
                }
            }

            this->Value -= Value

            EnableInterrupts()

            return true
        }

        define i8 Wait(i32 TimeoutMS) {
            return this->Wait(1, TimeoutMS)
        }

        define void Wait() {
            this->Wait(WAIT_FOREVER)
        }

        define void Decrement(i32 Value, i32 TimeoutMS) {
            this->Wait(Value, TimeoutMS)
        }
        define void Decrement(i32 Value) {
            this->Wait(Value, WAIT_FOREVER)
        }
        define void Decrement() {
            this->Wait(1, WAIT_FOREVER)
        }

        define void Signal(i32 Value) {
            i8 Guard := InterruptGuard()

            this->Value += Value
            SchedulerWakeOne(this->Waiters)

            InterruptRestore(Guard)
        }
        define void Signal() {
            this->Signal(1)
        }

        define void Increment() {
            this->Signal(1)
        }
        define void Increment(i32 Value) {
            this->Signal(Value)
        }
    }

    class Lock derives INew {
        i8* Name

        WaitQueue* Waiters
        i8 Locked

        Task* Owner

        define void New(i8* Name) {
            this->Name := Name
            this->Waiters := SchedulerRegisterWaitQueue(Name)

            this->Locked := 0

            ALL_LOCKS->Push(this)
        }

        define void Free() {
            ALL_LOCKS->RemoveValue(this)
            
            SchedulerUnregisterWaitQueue(this->Waiters)
            this->Delete()
        }

        define i8 Acquire(i32 TimeoutMS) {
            DisableInterrupts()

            while (this->Locked) {
                WaitResult Result := SchedulerWait(this->Waiters, TimeoutMS)
                
                if (Result = WaitResult::Timeout) {
                    EnableInterrupts()
                    return false
                }
            }

            this->Locked := true
            this->Owner := CurrentTask

            EnableInterrupts()

            return true
        }

        define void Acquire() {
            this->Acquire(0)
        }

        define i8 TryAcquire() {
            DisableInterrupts()

            if (this->Locked) {
                EnableInterrupts()
                return false
            }

            this->Locked := true
            this->Owner := CurrentTask

            EnableInterrupts()

            return true
        }

        define void Release() {
            DisableInterrupts()

            this->Locked := false
            this->Owner := null

            SchedulerWakeOne(this->Waiters)

            EnableInterrupts()
        }
    }
}

define void DUMP_SEMAPHORES() {
    Info("SEMAPHORES:\n")

    for (i32 Index := 0, Index < ALL_SEMAPHORES->Count(), Index++) {
        Synchronization::Semaphore* S := ALL_SEMAPHORES->Get(Index)

        Info("  %s: %i\n", S->Name, S->Value)
    }
}

define void DUMP_LOCKS() {
    Info("LOCKS:\n")

    for (i32 Index := 0, Index < ALL_LOCKS->Count(), Index++) {
        Synchronization::Lock* L := ALL_LOCKS->Get(Index)

        i8* State := "UNLOCKED"

        if (L->Locked) {
            State := "LOCKED"
        }

        Info("  %s: %s\n", L->Name, State)

        if (L->Locked) {
            Info("    Owner: %s\n", L->Owner->Name)
        }
    }
}

; lol
void DO_NOT_OPTIMIZE_AWAY_DUMP_SEMAPHORES := DO_NOT_OPTIMIZE_AWAY(&DUMP_SEMAPHORES)
void DO_NOT_OPTIMIZE_AWAY_DUMP_LOCKS := DO_NOT_OPTIMIZE_AWAY(&DUMP_LOCKS)
