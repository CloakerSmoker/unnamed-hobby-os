declare void Info(i8*, ...)
declare void DisableInterrupts()

define void Hang() {
    DisableInterrupts()
    loop {asm {emit, 0xF4}}
}

define void Halt() {
    DisableInterrupts()
    loop {asm {emit, 0xF4}}
}

define void Exit(i32 Code) {
    DisableInterrupts()
    Info("EXIT CALLED\n%stackdump\nHALTING")
    Halt()
}

declare void DUMP_TASKS()
declare void DUMP_WAIT_QUEUES()
declare void DUMP_LOCKS()
declare void DUMP_SEMAPHORES()

define void Panic(i8* Reason) {
    DisableInterrupts()
    Info("PANIC: %s\n%stackdump\nHALTING\n", Reason)

    DUMP_TASKS()
    DUMP_WAIT_QUEUES()
    DUMP_LOCKS()
    DUMP_SEMAPHORES()

    Halt()
}