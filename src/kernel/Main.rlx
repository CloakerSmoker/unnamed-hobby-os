define void InitializeTerminal(IDirectory* DevicesDirectory) {
	; /dev/ps2/{keyboard}

	IDirectory* PS2Directory := DevicesDirectory->CreateDirectory()
	DevicesDirectory->Insert("ps2", PS2Directory)

	IFileHandle* KeyboardHandle := new PS2KeyboardHandle()
	PS2Directory->Insert("keyboard", new VFSDeviceSingletonFile(KeyboardHandle))

	DefaultTerminalInput := new TerminalInputStreamHandle(KeyboardHandle)

	; /dev/pcspeaker
	IFileHandle* PCSpeaker := new PCSpeakerHandle()
	DevicesDirectory->Insert("pcspeaker", new VFSDeviceSingletonFile(PCSpeaker))

	TerminalRendererHandle* Renderer := new TerminalRendererHandle(PCSpeaker, PrimaryDisplay, BootFont, TERMINAL_FOREGROUND, TERMINAL_BACKGROUND)
	Renderer->SetCursorTimer()
	DefaultTerminalOutput := Renderer
	
	KernelTerminal := new TerminalHandle(DefaultTerminalInput, DefaultTerminalOutput)

	; Terminal: /dev/tty0
	DevicesDirectory->Insert("tty0", VFSDeviceSingletonFile:New(KernelTerminal))
}

