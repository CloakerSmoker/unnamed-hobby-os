	Print("Hello /dev/console!\n")
	
	KernelTerminal->DeviceControl(TERMINAL_RENDERER_START_CURSOR_TIMER, null)
	
	SetupShell()
	
	StartScheduler()

	*/
	
	Panic("Kernel returned from Main()")
}
