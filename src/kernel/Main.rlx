#Require "./src/kernel/file-system/VFS/DirectoryFileHandle.rlx"

define void ExecuteExecute(i32 ArgC, i8** ArgV) {
    i8* Path := ArgV[1]

    VFSDirectoryEntry Entry
    if !(Lookup(CurrentDirectory, Path, &Entry)) {
        Print("'%s' does not exist\n", Path)
        return
    }

    if (Entry.Type != VFSDirectoryEntryType::File) {
        Print("'%s' not a file\n", Path)
        return
    }

    IFile* InputFile := Entry.File
    IFileHandle* Input := InputFile->Open()

	Input->Seek(SeekMode::End, 0)
	i32 Size := Input->Tell()
	Input->Seek(SeekMode::Set, 0)

	void* Buffer := Alloc(Size)
	Input->Read(Buffer, Size)

	i8*[1] Environment {"USER=root"}

	ExecuteParameters Parameters {
		WorkingDirectory: new GenericDirectoryFileHandle(CurrentDirectory),

		StandardInput: DefaultTerminalInput,
		StandardOutput: DefaultTerminalOutput,
		StandardError: DefaultTerminalOutput,

		ArgumentCount: ArgC - 1,
		Arguments: &ArgV[1],

		EnvironmentCount: 1,
		Environment: Environment
	}

	Execute(Buffer, &Parameters)
}

i32 EXECUTE_COMMAND_ID := RegisterCommand("execute", &ExecuteExecute)

define IDirectory* OpenFSFromPath(i8* Path, IDirectory*(IBlockDevice*) OpenDevice) {
	VFSDirectoryEntry DeviceEntry

	if !(Lookup(null, Path, &DeviceEntry)) {
		return null
	}

    IFile* File := DeviceEntry.File

    if (File->TypeID() != typeid:(VFSBlockDeviceFile)) {
        return null
    }

    VFSBlockDeviceFile* BlockDeviceFile := File
    BlockDeviceFileHandle* BlockDeviceHandle := BlockDeviceFile->Handle
    IBlockDevice* RootDevice := BlockDeviceHandle->Device

	return OpenDevice(RootDevice)
}

define i8 TryMountPartitions(i8* RootPartitionGUID, i8* EFISystemPartitionGUID) {
	i8* EFISystemPartitionPath := FormatString("/dev/gpt/%s", EFISystemPartitionGUID)
	i8* RootPartitionPath := FormatString("/dev/gpt/%s", RootPartitionGUID)

	IDirectory* EFISystemRootDirectory := OpenFSFromPath(EFISystemPartitionPath, &OpenFAT32)
	IDirectory* RootDirectory := OpenFSFromPath(RootPartitionPath, &OpenExt2)

	if !(EFISystemRootDirectory && RootDirectory) {
		Free(EFISystemPartitionPath)
		Free(RootPartitionPath)

		return false
	}

	MountRoot(RootDirectory)
	Mount(null, "/efi", EFISystemRootDirectory)

	return true
}

define void NetworkSetupTask() {
	NetworkInterface* Interface := null

	i32 Count := ALL_I219_CONTROLLERS->Count()

	for (i32 Index := 0, Index < Count, Index++) {
		I219::Controller* NIC := ALL_I219_CONTROLLERS->At(Index)

		NIC->Start(Index)

		Interface := NIC->Interface
	}

	Network->AddInterface(Interface)

	Print("Network: Interface %s, MAC: %mac\n", Interface->Name, Interface->MAC)

	DHCPClient* DHCP := new DHCPClient(Interface)

	i8 Result := DHCP->EstablishLease()

	if (Result) {
		Print("DHCP established lease successfully\n")
	}
	else {
		Print("DHCP failed to establish lease\n")
		SleepMS(100000000)
	}

	Print("DHCP: Leased: %ipv4. DNS: %ipv4\n", Interface->IP, Interface->DNS)
    Network->AddRoute("0.0.0.0/0", Interface)

    Network->DumpRoutes()

	ARPLayer* ARP := Interface->WellKnownProtocols->ARP

    Interface->GatewayMAC := ARP->Lookup(Interface->Gateway)

    Print("DHCP: Gateway: %ipv4. Gateway MAC: %mac\n", Interface->Gateway, Interface->GatewayMAC)

	/*
	IFileHandle* UDP := new UDPSocketHandle()

	NetworkAddress BindAddress {
		Type: NetworkAddressType::Interface,
		Port: 7777 As i16
	}

	MoveMemory(BindAddress~>InterfaceName, Interface->Name, StringLength(Interface->Name))

	UDP->Bind(&BindAddress)

	void* Buffer := Alloc(2048)

	loop {
		UDP->Wait(POLL_FOR_READ, WAIT_FOREVER)

		NetworkAddress RemoteAddress
		i32 Size := UDP->RecieveFrom(Buffer, 2048, &RemoteAddress)

		Print("UDP: Received %i bytes from %ipv4:%net-port\n", Size, RemoteAddress.IPv4, RemoteAddress.Port)
		Print("%s\n", Buffer)
	}
	*/

	IFileHandle* Socket := new TCPSocketHandle()

	NetworkAddress BindAddress {
		Type: NetworkAddressType::IPv4,
		IPv4: Interface->IP,
		Port: 7777 As i16
	}

	Socket->Bind(&BindAddress)

	Socket->Listen()

    ;TCP->BindSocket(42830 As i16, Socket)
    ;TCP->BindSocket(7777 As i16, Socket)
    ;Network->Bind(Interface->IP, 7777 As i16, Socket)

    ;Socket->Interface->SetKnobToggle("Ethernet.SpewInOut", true)

    ;Socket->Connect(PackIPV4(10, 0, 2, 2), 7778)

    ;while (Socket->State != TCP_SOCKET_STATE_ESTABLISHED) { SchedulerYield() }

    ;Socket->Listen()

    loop {
		if !(Socket->Wait(POLL_FOR_READ, WAIT_FOREVER)) {
			continue
		}

		Print("TCP: Reports ready to accept connection\n")

		NetworkAddress RemoteAddress

        IFileHandle* Child := Socket->Accept(&RemoteAddress)

		if !(Child) {
			continue
		}

        if !(Child->Wait(POLL_FOR_WRITE, 5000)) {
			Print("Failed to establish TCP connection with %ipv4:%net-port\n", RemoteAddress.IPv4, RemoteAddress.Port)
			continue
		}

        Print("Say hello to %ipv4:%net-port!\n", RemoteAddress.IPv4, RemoteAddress.Port)

        while (Child->Poll(POLL_FOR_WRITE) & POLL_CAN_WRITE) {
            i8[100] Line
			
			if !(Child->Wait(POLL_FOR_READ, WAIT_FOREVER)) {
				Print("TCP: Can't read\n")
				break
			}

            i32 Size := Child->Recieve(Line, 100)
            
            if (Size) {
                Line[Size] := 0

                Print("%s", Line)
            }
        }

		Print("Remote closed, waiting for a new one!\n")
    }
}

i8* ROOT_PARTITION_GUID := null
i8* EFI_SYSTEM_PARTITION_GUID := null

define void MainTask() {
	; Start disk controllers

	i32 ControllerCount := ALL_AHCI_CONTROLLERS->Count()

	for (i32 ControllerIndex := 0, ControllerIndex < ControllerCount, ControllerIndex++) {
		SATA::AHCI::Controller* Controller := ALL_AHCI_CONTROLLERS->At(ControllerIndex)

		Print("Starting AHCI controller %i\n", ControllerIndex)
		Controller->Start(ControllerIndex)
	}

	Print("Looking for disks:\n")
	Print("  EFI Partition GUID: %s\n", EFI_SYSTEM_PARTITION_GUID)
	Print("  Root Partition GUID: %s\n", ROOT_PARTITION_GUID)

	; Wait for root/EFI partitions to be detected

	i64 StartTime := GetUptimeMS()

	loop {
		if (TryMountPartitions(ROOT_PARTITION_GUID, EFI_SYSTEM_PARTITION_GUID)) {
			break
		}

		SleepMS(1000)
		Print(".")

		if (GetUptimeMS() - StartTime > 30000) {
			Panic("Could not find root/EFI partitions after 30 seconds, halting...")
		}
	}

	; TODO: This needs to be earlier in the boot process.
	; There's definitely root devices that we can't mount without ACPI
	; but since we load ACPICA.elf from the root partition, we're screwed
	SetupACPI()

	Task* ShellThread := Scheduler->AddLightTask(&VFSRunShellTask, "VFS Shell")
	Scheduler->SetRunnable(ShellThread)
}

define void XHCITask() {


	i32 Count := ALL_XHCI_CONTROLLERS->Count()

	for (i32 Index := 0, Index < Count, Index++) {
		USB::XHCI::Controller* Controller := ALL_XHCI_CONTROLLERS->At(Index)

		Print("Starting XHCI controller %i\n", Index)
		Controller->Start(Index)
	}

	SleepMS(0x7FFF_FFFF)
}

define void Main(TrampolineInfo* Info) {
	DO_NOT_OPTIMIZE_AWAY(&PreMain)

	DisableInterrupts()

	MAIN_ENTERED := true

	CurrentTask := KernelSetupTask

	i64 ArgC := 0
	i8*[10] ArgV

	ParseCommandLine(BootInfo~>KernelCommandLine, &ArgC, ArgV)
	
	for (i32 Index := 0, Index < ArgC, Index++) {
		i8* Next := ArgV[Index]

		if (StringEquals(Next, "--efi-system-guid")) {
			EFI_SYSTEM_PARTITION_GUID := ArgV[++Index]
		}
		else if (StringEquals(Next, "--root-guid")) {
			ROOT_PARTITION_GUID := ArgV[++Index]
		}
	}

	;KernelAddressSpace->PrintMappings()

	Info("Root Partition       GUID: %s\n", ROOT_PARTITION_GUID)
	Info("EFI System Partition GUID: %s\n", EFI_SYSTEM_PARTITION_GUID)

	PhysicalPageAllocator* Physical := KernelHeapAllocate('PGTREEPM', #PhysicalPageAllocator)
	Physical->Initialize()
	Physical->Manager := PhysicalMemory

	Info~>PageTree->Initialize(KernelAddressSpace->VirtualPML4, Physical)
	
	i64 KernelPages := PhysicalMemory->Allocate(NUMBER_OF_KERNEL_PAGES)
	KernelAddressSpace->MapRange(ADDRESS_OF_KERNEL_PAGES, KernelPages / PAGE_SIZE, NUMBER_OF_KERNEL_PAGES, PAGE_PRESENT | PAGE_WRITE)
	FastZeroMemory(ADDRESS_OF_KERNEL_PAGES, NUMBER_OF_KERNEL_PAGES * PAGE_SIZE)
	KernelPageAllocator := PageHeap:Adopt(ADDRESS_OF_KERNEL_PAGES, NUMBER_OF_KERNEL_PAGES)
	
	Info("Built kernel virtual allocator\n")
	
	LoadBootFont()
	
	Info("Loaded font\n")
	
	i32 FrameBufferPageCount := SizeToPageCount(BootInfo->FrameBufferWidth * BootInfo->FrameBufferHeight * 4)
	KernelAddressSpace->MapRange(ADDRESS_OF_FRAME_BUFFER, BootInfo->PhysicalFrameBuffer / PAGE_SIZE, FrameBufferPageCount)
	
	Info("Mapped the framebuffer\n")
	
	Scheduler->Initialize()

	PixelBuffer* FrameBuffer := Alloc(#PixelBuffer)
	FrameBuffer->Initialize(ADDRESS_OF_FRAME_BUFFER, RGB32, BootInfo->FrameBufferWidth, BootInfo->FrameBufferHeight)

	PrimaryDisplay := FrameBuffer

	SetupInterrupts()
	;GenerateInterruptHandlers()

	MountRoot(VFSDirectory:New())

	VFSDevicesDirectory := VFSDirectory:New()
	Mount(null, "/dev", VFSDevicesDirectory)

	InitializeTerminal(VFSDevicesDirectory)
	Printer := &KernelPrinter
	
	Print("BOOT: Screen *probably* works\n")
	
	KernelAddressSpace->Map(0 As void*, 0, PAGE_NOT_PRESENT)
	
	Print("BOOT: Unmapped page 0\n")
	
	SetCR4(GetCR4() | CR4_ENABLE_FS_GS_BASE)
	
	SetupGDT()
	
	Print("BOOT: Setup GDT and TSS\n")
	
	SetupKeyboard()
	
	if (BootInfo->HPETBase && HPET_CAN_PROVIDE_SYSTEM_CLOCK) {
		Print("TIME: HPET is present and enabled, attempting to use as system clock\n")

		if (ConfigureHPETSystemClock(SYSTEM_CLOCK_HZ)) {
			SYSTEM_CLOCK_RUNNING := true
			Print("TIME: HPET selected/configured as system clock\n")
		}
		else {
			Print("TIME: HPET does not meet requirements for system clock\n")
		}
	}

	if !(SYSTEM_CLOCK_RUNNING) {
		ConfigurePITSystemClock(SYSTEM_CLOCK_HZ)
		SYSTEM_CLOCK_RUNNING := true
		Print("TIME: PIT selected/configured as system clock\n")
	}

	Print("TIME: System clock is running\n")

	RegisterSerialInterrupts()
	
	SetupKernelGS()
	SetupUserMode()
	SetupSystemCalls()

	Network := NetworkStack:New()

	Network->AddInterface(MakeLoopbackNetworkInterface(IPv4("127.0.0.1")))

	Print("Created loopback interface\n")

	Print("Enumerating PCIe devices:\n")

	;loop {}

	;i32 Y := StringLength(RootPartitionGUID) / 0

	;loop {}

	KERNEL_JOBS := new JobQueue()

	InitializePCIe(&VisitPCIeFunction)

	Print("Done enumerating PCIe\n")

	PopulateDevicesDirectory(VFSDevicesDirectory)
	
	Task* MainTaskThread := Scheduler->AddLightTask(&XHCITask, "Main Task")
	Scheduler->SetRunnable(MainTaskThread)

	StartScheduler()

	;i8*[2] Args {"/bin/ls", "/dev"}
	;ExecuteLS(2, Args)

	;loop {}

	PageTrie* Trie := Info~>PageTree

	i64 State := Trie->StartWalkMappings()
	VirtualMapping Mapping

	while (Trie->WalkMappingsNext(&State, &Mapping)) {
		Print("%x..%x -> %x..%x (%x pages)\n", Mapping.Virtual, Mapping.Virtual + Mapping.Size, Mapping.Physical, Mapping.Physical + Mapping.Size, Mapping.Size / PAGE_SIZE)
	}

	Print("done\n")

	SetupACPI()

	;Halt()

	;Halt()

	;NetworkSetupTask()

	Print("Initializing UHCI controller...\n")

	UHCIController->Setup()

	Info("UHCI Controller initialized\n")

	;StartScheduler()

	Task* NetworkThread := Scheduler->AddLightTask(&NetworkSetupTask, "Network Setup")
	Scheduler->SetRunnable(NetworkThread)

	Task* ShellThread := Scheduler->AddLightTask(&VFSRunShellTask, "VFS Shell")
	Scheduler->SetRunnable(ShellThread)

	StartScheduler()

	;*/

	;/*
	;SetupNetworking()
	
	/*
	Task* NetworkThread := Scheduler->AddLightTask(null)
	NetworkThread~>Context->Call(&SocketListener)
	NetworkThread->State := TASK_CAN_RUN

	Task* NetworkThread2 := Scheduler->AddLightTask(null)
	NetworkThread2~>Context->Call(&SocketClient)
	NetworkThread2->State := TASK_CAN_RUN
	;*/

	/*
	Task* NetworkThread2 := Scheduler->AddLightTask(null)
	NetworkThread2~>Context->Call(&TestNetworking)
	NetworkThread2->State := TASK_CAN_RUN
	;*/

	StartScheduler()
	;*/
	
	/*
	if !(DiskController->IsInitialized) {
		Print("Didn't find disk controller, hanging\n")
		
		loop {asm {emit, 0xF4}}
	}
	
	DiskController->DetectDevices()
	
	i32 FirstDiskIndex := DiskController->FindFirstDiskIndex()
	
	if (FirstDiskIndex < -1) {
		Print("Didn't find any disks, hanging\n")
		
		loop {asm {emit, 0xF4}}
	}
	
	for (i32 Index := 0, Index < 4, Index++) {
		ATADevice* Disk := DiskController->Disk(Index)
		
		Print("\thd%c - ", 'a' + Index)
		
		if (Disk) {
			Print("%s:%s, %x blocks\n", Disk->Model, Disk->Serial, Disk->MaxLBA)
		}
		else {
			Print("not present\n")
		}
	}
	*/
	
	/*

	Info("E1000 Status: %b\n", FirstE1000->PCIe->Status)
	Info("E1000 Command: %b\n", FirstE1000->PCIe->Command)
	
	FirstE1000->Setup()

	Info("E1000 Status: %b\n", FirstE1000->PCIe->Status)
	Info("E1000 Command: %b\n", FirstE1000->PCIe->Command)
	
	void* Buffer := KernelPageAllocator->AllocateVirtual(2)
	
	PacketBuffer* Packet := Alloc(#PacketBuffer)

	Packet->Initialize(Buffer)
	
	i8* MulticastMAC := i8[0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]
	MACAddress* MyMAC := FirstE1000->MAC As void*
	i32 MyIP := 0x01020304

	Print("My MAC is: %mac\n", MyMAC)
	
	Print("Status %x\nCommand %x\n", FirstE1000->Read(E1000_REGISTER_STATUS), FirstE1000->Read(E1000_REGISTER_CTRL))

	EthernetHeader* Ethernet := EnterEthernetHeader(Packet)

	MoveMemory(Ethernet~>SourceMAC, MyMAC, 6)
	MoveMemory(Ethernet~>DestinationMAC, MulticastMAC, 6)

	Ethernet->EtherType := ETHERTYPE_IPV4

