i8 KEY_MODIFIER_SHIFT    := 1
i8 KEY_MODIFIER_ALT      := 2
i8 KEY_MODIFIER_CONTROL  := 4
i8 KEY_MODIFIER_META     := 8
i8 KEY_MODIFIER_RELEASED := 16

define i8 Modifier(i8 Modifiers, i8 Mask) {
	return (Modifiers != 0) && (Modifiers & Mask) = Mask
}

define void PrintModifiers(i8 Modifiers) {
	if (Modifiers & KEY_MODIFIER_SHIFT) {
		Print("shift ")
	}
	
	if (Modifiers & KEY_MODIFIER_ALT) {
		Print("alt ")
	}
	
	if (Modifiers & KEY_MODIFIER_CONTROL) {
		Print("control ")
	}
	
	if (Modifiers & KEY_MODIFIER_META) {
		Print("meta ")
	}
}

i32 KEY_SPECIAL_BASE := 1
i32 KEY_HOME         := 1
i32 KEY_INSERT       := 2
i32 KEY_DELETE       := 3
i32 KEY_END          := 4
i32 KEY_PAGE_UP      := 5
i32 KEY_PAGE_DOWN    := 6
i32 KEY_BELL         := 7
i32 KEY_BACKSPACE    := 8
i32 KEY_TAB          := 9
i32 KEY_ENTER        := 10
i32 KEY_F1           := 11
i32 KEY_F2           := 12
i32 KEY_F3           := 13
i32 KEY_F4           := 14
i32 KEY_F5           := 15
i32 KEY_F6           := 16
i32 KEY_F7           := 17
i32 KEY_F8           := 18
i32 KEY_F9           := 19
i32 KEY_F10          := 20
i32 KEY_F11          := 21
i32 KEY_F12          := 22
i32 KEY_UP           := 23
i32 KEY_DOWN         := 24
i32 KEY_RIGHT        := 25
i32 KEY_LEFT         := 26
i32 KEY_ESCAPE       := 27
i32 KEY_ENTER        := 28
i32 KEY_SHIFT        := 29
i32 KEY_CONTROL      := 30
i32 KEY_ALT          := 31
i32 KEY_SPECIAL_LAST := 31

i32 KEY_ASCII_BASE := 32
i32 KEY_ASCII_LAST := 126

define void PrintKeyName(i32 KeyCode) {
	i8*[31] Names {
		"home", "insert", "delete", "end", "page-up", "page-down", "bell", "backspace", "tab",
		"enter", "F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10", "F11", "F12",
		"up", "down", "right", "left",
		"escape", "enter",
		"shift", "control", "alt"
	}
	
	if (KEY_SPECIAL_BASE <= KeyCode && KeyCode <= KEY_SPECIAL_LAST) {
		Print("%s", Names[KeyCode - KEY_SPECIAL_BASE])
	}
	else if (KeyCode = ' ') {
		Print("space")
	}
	else {
		Print("%c", KeyCode)
	}
}



struct KeyInput {
	union {
		struct {
			i32 KeyCode
			i8 Modifiers

			i8 ASCII
		}

		i64 _
	}

	define void Assign(i8 Modifiers, i32 KeyCode) {
		this->Modifiers := Modifiers
		this->KeyCode := KeyCode
		this->ASCII := 0

		if (KeyCode >= KEY_ASCII_BASE && KeyCode <= KEY_ASCII_LAST) {
			this->ASCII := KeyCode As i8

			if (Modifiers = KEY_MODIFIER_CONTROL) {
				if ('a' <= KeyCode && KeyCode <= 'z') {
					this->ASCII -= 'a'
				}
			}
			else if (Modifiers & KEY_MODIFIER_SHIFT = KEY_MODIFIER_SHIFT) {
				; shift + lowercase_letter = uppercase_letter

				Modifiers ^= KEY_MODIFIER_SHIFT
				
				if ('a' <= KeyCode && KeyCode <= 'z') {
					this->ASCII ^= 0x20
				}
				else if ('0' <= KeyCode && KeyCode <= '9') {
					i8* ShiftedNumbers := i8[')', '!', '@', '#', '$', '%', '^', '&', '*', '(']
					this->ASCII := ShiftedNumbers[KeyCode - '0']
				}
				else if (',' <= KeyCode && KeyCode <= '/') {
					i8* ShiftedMisc := i8['<', '_', '>', '?']
					this->ASCII := ShiftedMisc[KeyCode - ',']
				}
				else if (KeyCode = ''') {
					this->ASCII := '"'
				}
				else if (KeyCode = ';') {
					this->ASCII := ':'
				}
				else if (KeyCode = '[') {
					this->ASCII := '{'
				}
				else if (KeyCode = ']') {
					this->ASCII := '}'
				}
				else if (KeyCode = '=') {
					this->ASCII := '+'
				}
				else if (KeyCode = '\') {
					this->ASCII := '|'
				}
			}
		}
		else {
			this->ASCII := 0
		}
	}
}