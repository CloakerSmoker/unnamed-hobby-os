namespace USB {
    enum RequestRecipient As i8 {
        Device := 0,
        Interface := 1,
        Endpoint := 2,
        Other := 3
    }

    enum RequestType As i8 {
        Standard := 0,
        Class := 1,
        Vendor := 2,
        Reserved := 3
    }

    enum RequestDataPhaseDirection As i8 {
        HostToDevice := 0,
        DeviceToHost := 1
    }

    enum StandardRequests As i8 {
        GET_STATUS := 0,
        CLEAR_FEATURE := 1,
        SET_FEATURE := 3,
        SET_ADDRESS := 5,
        GET_DESCRIPTOR := 6,
        SET_DESCRIPTOR := 7,
        GET_CONFIGURATION := 8,
        SET_CONFIGURATION := 9
    }

    bits GetDescriptorValue As i16 {
        USB::DescriptorType [8:15] Type
        [0:7] Index
    }

    struct SetupPacket {
        bits As i8 {
            RequestRecipient [0:4] Recipient
            RequestType [5:6] Type
            RequestDataPhaseDirection [7] DataDirection
        }

        union {
            StandardRequests StandardRequest
            i8 ClassRequest
            i8 VendorRequest
        }

        union {
            i16 Value
            GetDescriptorValue GetDescriptor
        }

        i16 Index
        i16 Length

        define void MakeSetAddress(i8 Address) {
            this->Recipient := RequestRecipient::Device
            this->Type := RequestType::Standard
            this->DataDirection := RequestDataPhaseDirection::HostToDevice

            this->StandardRequest := StandardRequests::SET_ADDRESS
            this->Value := Address
            this->Index := 0
            this->Length := 0
        }

        define void MakeGetDescriptor(USB::DescriptorType Type, LanguageID Language, i8 DescriptorIndex, i16 Length) {
            this->Recipient := RequestRecipient::Device
            this->Type := RequestType::Standard
            this->DataDirection := RequestDataPhaseDirection::DeviceToHost

            this->StandardRequest := StandardRequests::GET_DESCRIPTOR
            this->GetDescriptor.Type := Type
            this->GetDescriptor.Index := DescriptorIndex
            this->Index := Language As i16
            this->Length := Length
        }
        define void MakeGetDescriptor(USB::DescriptorType Type, i8 DescriptorIndex, i16 Length) {
            this->MakeGetDescriptor(Type, LanguageID::None, DescriptorIndex, Length)
        }


        define void MakeSetConfiguration(i8 ConfigurationIndex) {
            this->Recipient := RequestRecipient::Device
            this->Type := RequestType::Standard
            this->DataDirection := RequestDataPhaseDirection::HostToDevice

            this->StandardRequest := StandardRequests::SET_CONFIGURATION
            this->Value := ConfigurationIndex
            this->Index := 0
            this->Length := 0
        }
    }
}