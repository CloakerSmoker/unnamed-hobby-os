
i8 USB_CLASS_HID := 0x03

i8 USB_HID_SUBCLASS_NONE := 0x00
i8 USB_HID_PROTOCOL_NONE := 0x00
i8 USB_HID_PROTOCOL_KEYBOARD := 0x01
i8 USB_HID_PROTOCOL_MOUSE := 0x02

i8 USB_HID_SUBCLASS_BOOT := 0x01
i8 USB_HID_BOOT_PROTOCOL_NONE := 0x00
i8 USB_HID_BOOT_PROTOCOL_KEYBOARD := 0x01
i8 USB_HID_BOOT_PROTOCOL_MOUSE := 0x02

namespace USB::HID {

    enum SubDescriptorType As i8 {
        Report := 0x22,
        Physical := 0x23
    }

    struct SubDescriptor {
        SubDescriptorType Type
        i8 Size
    }

    struct Descriptor {
        DescriptorHeader Header

        i16 SpecificationVersion
        i8 CountryCode

        i8 SubDescriptorCount
        SubDescriptor[0] Descriptors
    }

    enum ItemType As i8 {
        Main := 0,
        Global := 1,
        Local := 2,
        Reserved := 3
    }

    enum MainItemTag As i8 {
        Input := 0b1000,
        Output := 0b1001,
        Collection := 0b1010,
        Feature := 0b1011,
        EndCollection := 0b1100
    }

    enum GlobalItemTag As i8 {
        UsagePage := 0b0000,

        LogicalMinimum := 0b0001,
        LogicalMaximum := 0b0010,

        PhysicalMinimum := 0b0011,
        PhysicalMaximum := 0b0100,

        UnitExponent := 0b0101,
        Unit := 0b0110,

        ReportSize := 0b0111,
        ReportID := 0b1000,
        ReportCount := 0b1001,

        Push := 0b1010,
        Pop := 0b1011
    }

    enum LocalItemTag As i8 {
        Usage := 0b0000,
        UsageMinimum := 0b0001,
        UsageMaximum := 0b0010,

        DesignatorIndex := 0b0011,
        DesignatorMinimum := 0b0100,
        DesignatorMaximum := 0b0101,

        StringIndex := 0b0110,
        StringMinimum := 0b0111,
        StringMaximum := 0b1000,
        
        Delimiter := 0b1001
    }

    bits ItemHeader As i8 {
        [0:1] Size
        ItemType [2:3] Type
        MainItemTag [4:7] MainTag
        GlobalItemTag [4:7] GlobalTag
        LocalItemTag [4:7] LocalTag
    }

    enum MainItemFlag As i32 {
        ; If even: expected bit value is 0, if odd: expected bit value is 1
        ; Bit index = Value / 2

        Data, Constant,
        Array, Variable,
        Absolute, Relative,
        NoWrap, Wrap,
        Linear, NonLinear,
        PreferredState, NoPreferredState,
        NoNullState, NullState,
        NonVolatile, Volatile,

        BitField := 16, ; 16 / 8 = bit 8, expected value is 0
        BufferedBytes := 17 ; 17 / 8 = bit 8, expected value is 1

        Last := 17
    }

    bits InputItemData As i32 {
        [0] IsConstant
        [1] IsArray
        [2] IsRelative
        [3] Wraps
        [4] IsNonLinear
        [5] HasNoPreferredState
        [6] HasNullState
        [8] IsBufferedBytes

        define i8 HasFlag(MainItemFlag Flag) {
            i32 BitIndex := (Flag As i32) / 2
            i32 ExpectedValue := (Flag As i32) % 2

            i32 Mask := 1 << BitIndex
            i32 Value := (this As i32) & Mask

            return Value = (ExpectedValue << BitIndex)
        }
    }

    bits OutputItemData As i32 {
        [0] IsConstant
        [1] IsArray
        [2] IsRelative
        [3] Wraps
        [4] IsNonLinear
        [5] HasNoPreferredState
        [6] HasNullState
        [7] IsVolatile
        [8] IsBufferedBytes
    }

    bits FeatureItemData As i32 {
        [0] IsConstant
        [1] IsArray
        [2] IsRelative
        [3] Wraps
        [4] IsNonLinear
        [5] HasNoPreferredState
        [6] HasNullState
        [7] IsVolatile
        [8] IsBufferedBytes
    }

    enum CollectionItemData {
        Physical := 0,
        Application := 1,
        Logical := 2,
        Report := 3,
        NamedArray := 4,
        UsageSwitch := 5,
        UsageModifier := 6
        Root := 80
    }

    class ItemInfo derives INew {
        ItemHeader Header
        
        union {
            i32 Value

            InputItemData InputData
            OutputItemData OutputData
            FeatureItemData FeatureData
            CollectionItemData CollectionData
        }

        define void New(ItemHeader Header, i32 Value) {
            this->Header := Header
            this->Value := Value
        }
    }

    struct GlobalState {
        i32 UsagePage

        i32 LogicalMinimum
        i32 LogicalMaximum

        i32 PhysicalMinimum
        i32 PhysicalMaximum

        i32 UnitExponent
        i32 Unit

        i32 ReportSize
        i32 ReportID
        i32 ReportCount
    }

    struct LocalState {
        i8 UseUsageStack

        i32 UsageMinimum
        i32 UsageMaximum

        i32 DesignatorIndex
        i32 DesignatorMinimum
        i32 DesignatorMaximum

        i32 StringIndex
        i32 StringMinimum
        i32 StringMaximum

        i8 Delimiter

        define void Zero() {
            FastZeroMemory(this, #self)
        }
    }

    struct MainItem {
        ItemInfo* Info

        ; From global state
        i32 UsagePage

        i32 LogicalMinimum
        i32 LogicalMaximum

        i32 PhysicalMinimum
        i32 PhysicalMaximum

        i32 UnitExponent
        i32 Unit

        i32 ReportSize
        i32 ReportID

        ; From local state

        i32 Usage
    }

    bits CollectionEntry As i64 {
        [63] IsCollection
        Collection* [0:62] CollectionValue
        ItemInfo* [0:62] ItemValue
    }

    class Collection derives INew {
        PointerArray* Items ; <CollectionEntry>

        ItemInfo* Info

        define void New(ItemInfo* Info) {
            this->Items := new PointerArray()
            this->Info := Info
        }

        define void Push(ItemInfo* Item) {
            CollectionEntry Entry := 0 As CollectionEntry

            Entry.IsCollection := 0
            Entry.ItemValue := Item

            this->Items->Push(Entry As void*)
        }
        define void Push(Collection* Child) {
            CollectionEntry Entry := 0 As CollectionEntry

            Entry.IsCollection := 1
            Entry.CollectionValue := Child

            this->Items->Push(Entry As void*)
        }
    }

    class ReportField derives INew {
        MainItem* Item
        i32 Offset

        define void New(MainItem* Item, i32 Offset) {
            this->Item := Item
            this->Offset := Offset
        }
    }

    class ReportLayout derives INew {
        PointerArray* Fields ; <ReportField*>
        i32 ID

        define void New(i32 ID) {
            this->Fields := new PointerArray()
            this->ID := ID
        }

        i32 Offset
        i32 Size

        define ReportField* AddField(MainItem* Item) {
            ReportField* Field := new ReportField(Item, this->Offset)
            this->Fields->Push(Field)

            this->Offset += Item->ReportSize

            return Field
        }

        define void Seal() {
            this->Size := this->Offset
        }

        i8* Buffer

        define i64 ReadBit(i32 Index) {
            i32 ByteIndex := Index / 8
            i32 BitIndex := Index % 8

            if (ByteIndex >= this->Size) {
                return 0
            }

            return (this->Buffer[ByteIndex] >> BitIndex) & 1
        }
        define i64 ReadBits(i32 Index, i32 Count) {
            i64 Result := 0

            for (i32 BitIndex := 0, BitIndex < Count, BitIndex++) {
                Result |= this->ReadBit(Index + BitIndex) << BitIndex
            }

            return Result
        }

        define i64 Read(ReportField* Field) {
            i64 Value := this->ReadBits(Field->Offset, Field->Item->ReportSize)

            if (Field->Item->LogicalMinimum < 0) {
                i64 SignBit := 1 << (Field->Item->ReportSize - 1)

                if (Value & SignBit) {
                    ; Sign extend
                    Value |= ~((1 << Field->Item->ReportSize) - 1)
                }
            }

            return Value
        }
    }

    class ReportDescriptorParser derives INew {
        union {
            i8* Bytes
            void* Buffer
        }

        i32 Length
        i32 Position

        define i8 AtEnd() {
            return this->Position >= this->Length
        }

        define i8 ReadByte() {
            if (this->AtEnd()) {
                return 0
            }
            
            return this->Bytes[this->Position++]
        }

        define ItemInfo* ParseItem() {
            ItemInfo* Result := Alloc(#ItemInfo)

            ItemHeader Header := this->ReadByte() As ItemHeader

            i32 Value := 0

            for (i32 Index := 0, Index < Header.Size, Index++) {
                Value := Value << 8
                Value |= this->ReadByte()
            }

            return new ItemInfo(Header, Value)
        }

        define Collection* ParseCollection(ItemInfo* Info) {
            Collection* Result := new Collection(Info)

            while !(this->AtEnd()) {
                ItemInfo* Item := this->ParseItem()

                if (Item->Header.Type = ItemType::Main && Item->Header.MainTag = MainItemTag::EndCollection) {
                    break
                }

                if (Item->Header.Type = ItemType::Main && Item->Header.MainTag = MainItemTag::Collection) {
                    Result->Push(this->ParseCollection(Item))
                } else {
                    Result->Push(Item)
                }
            }

            return Result
        }

        Collection* Root

        define void Parse() {
            ItemHeader FakeHeader := 0 As ItemHeader

            FakeHeader.Type := ItemType::Main
            FakeHeader.MainTag := MainItemTag::Collection

            ItemInfo* FakeItem := new ItemInfo(FakeHeader, CollectionItemData::Root As i32)

            this->Root := this->ParseCollection(FakeItem)
        }

        i8 HasReportID
        LocalState* Local
        GlobalState* Global

        i32* UsageStack
        i32 UsageStackSize

        define void PushUsage(i32 Usage) {
            this->UsageStack := ReAlloc(this->UsageStack, this->UsageStackSize * #i32)

            MoveMemory(&this->UsageStack[1], &this->UsageStack[0], this->UsageStackSize++ * #i32)
            
            this->UsageStack[0] := Usage
        }
        define i32 PopUsage() {
            i32 Index := --this->UsageStackSize

            return this->UsageStack[Index]
        }

        AVLTree* InputReportLayouts ; <ReportLayout*>
        AVLTree* OutputReportLayouts ; <ReportLayout*>
        AVLTree* FeatureReportLayouts ; <ReportLayout*>

        define i32 MakeUnsigned(i32 Value) {
            if (Value < 0) {
                return Value & 0xFF
            }

            return Value
        }

        define void ExecuteLocalItem(ItemInfo* Item) {
            LocalState* Local := this->Local
            LocalItemTag Tag := Item->Header.LocalTag

            Info("\t%s := %i\n", nameof:(Tag), Item->Value)

            if (Tag = LocalItemTag::Usage) {
                Local->UseUsageStack := true

                this->PushUsage(this->MakeUnsigned(Item->Value))
            }
            else if (Tag = LocalItemTag::UsageMinimum) {
                Local->UseUsageStack := false
                Local->UsageMinimum := this->MakeUnsigned(Item->Value)
            }
            else if (Tag = LocalItemTag::UsageMaximum) {
                Local->UseUsageStack := false
                Local->UsageMaximum := this->MakeUnsigned(Item->Value)
            }
            else if (Tag = LocalItemTag::DesignatorIndex) {
                Local->DesignatorIndex := Item->Value
            }
            else if (Tag = LocalItemTag::DesignatorMinimum) {
                Local->DesignatorMinimum := Item->Value
            }
            else if (Tag = LocalItemTag::DesignatorMaximum) {
                Local->DesignatorMaximum := Item->Value
            }
            else if (Tag = LocalItemTag::StringIndex) {
                Local->StringIndex := Item->Value
            }
            else if (Tag = LocalItemTag::StringMinimum) {
                Local->StringMinimum := Item->Value
            }
            else if (Tag = LocalItemTag::StringMaximum) {
                Local->StringMaximum := Item->Value
            }
            else if (Tag = LocalItemTag::Delimiter) {
                Local->Delimiter := Item->Value As i8
            }
        }

        define void ExecuteGlobalItem(ItemInfo* Item) {
            GlobalState* Global := this->Global
            GlobalItemTag Tag := Item->Header.GlobalTag

            Info("\t%s := %i\n", nameof:(Tag), Item->Value)

            if (Tag = GlobalItemTag::UsagePage) {
                Global->UsagePage := Item->Value
            }
            else if (Tag = GlobalItemTag::LogicalMinimum) {
                Global->LogicalMinimum := Item->Value
            }
            else if (Tag = GlobalItemTag::LogicalMaximum) {
                Global->LogicalMaximum := Item->Value
            }
            else if (Tag = GlobalItemTag::PhysicalMinimum) {
                Global->PhysicalMinimum := Item->Value
            }
            else if (Tag = GlobalItemTag::PhysicalMaximum) {
                Global->PhysicalMaximum := Item->Value
            }
            else if (Tag = GlobalItemTag::UnitExponent) {
                Global->UnitExponent := Item->Value
            }
            else if (Tag = GlobalItemTag::Unit) {
                Global->Unit := Item->Value
            }
            else if (Tag = GlobalItemTag::ReportSize) {
                Global->ReportSize := Item->Value
            }
            else if (Tag = GlobalItemTag::ReportID) {
                Global->ReportID := Item->Value
            }
            else if (Tag = GlobalItemTag::ReportCount) {
                Global->ReportCount := Item->Value
            }
        }

        define void ExecuteMainItem(ItemInfo* Item) {
            MainItemTag Tag := Item->Header.MainTag
            i32 Count := this->Global->ReportCount

            if (Count = 0) {
                Count := 1 ; Fingers crossed nobody ever actually specifies a report count of 0
            }

            Info("HID Parser executing main item: %s, Count %i\n", nameof:(Tag), Count)

            for (i32 Index := 0, Index < Count, Index++) {
                MainItem* Main := Alloc(#MainItem)

                Main->Info := Item

                if (this->Local->UseUsageStack) {
                    Main->Usage := this->PopUsage()
                }
                else {
                    Main->Usage := this->Local->UsageMinimum + Index
                }

                Main->UsagePage := this->Global->UsagePage
                Main->LogicalMinimum := this->Global->LogicalMinimum
                Main->LogicalMaximum := this->Global->LogicalMaximum
                Main->PhysicalMinimum := this->Global->PhysicalMinimum
                Main->PhysicalMaximum := this->Global->PhysicalMaximum
                Main->UnitExponent := this->Global->UnitExponent
                Main->Unit := this->Global->Unit
                Main->ReportSize := this->Global->ReportSize
                Main->ReportID := this->Global->ReportID

                AVLTree* Layouts := null

                if (Tag = MainItemTag::Input) {
                    Layouts := this->InputReportLayouts
                }
                else if (Tag = MainItemTag::Output) {
                    Layouts := this->OutputReportLayouts
                }
                else if (Tag = MainItemTag::Feature) {
                    Layouts := this->FeatureReportLayouts
                }

                ReportLayout* Layout := Layouts->GetPointer(Main->ReportID)

                if (Layout = null) {
                    Layout := new ReportLayout(Main->ReportID)
                    Layouts->InsertPointer(Main->ReportID, Layout)
                }

                Layout->AddField(Main)
            }

            this->Local->Zero()
            this->UsageStackSize := 0
        }

        define void ExecuteItem(ItemInfo* Info) {
            ItemType Type := Info->Header.Type

            Info("HID Parser executing item: Type %s\n", nameof:(Type))

            if (Type = ItemType::Main) {
                this->ExecuteMainItem(Info)
            }
            else if (Type = ItemType::Global) {
                this->ExecuteGlobalItem(Info)
            }
            else if (Type = ItemType::Local) {
                this->ExecuteLocalItem(Info)
            }
        }

        define void ExecuteCollection(Collection* Root) {
            i32 Count := Root->Items->Count()
            
            Info("HID Parser executing collection with %i items\n", Count)

            for (i32 Index := 0, Index < Count, Index++) {
                CollectionEntry Entry := Root->Items->At(Index) As CollectionEntry

                if (Entry.IsCollection) {
                    this->ExecuteCollection(Entry.CollectionValue)
                } else {
                    this->ExecuteItem(Entry.ItemValue)
                }
            }
        }

        define void SealReportLayouts(AVLTree* Layouts) {
            i32 Count := Layouts->Count()

            for (i32 Index := 0, Index < Count, Index++) {
                ReportLayout* Layout := Layouts->PointerAt(Index)

                Layout->Seal()
            }
        }

        define void Execute() {
            this->ExecuteCollection(this->Root)

            this->SealReportLayouts(this->InputReportLayouts)
            this->SealReportLayouts(this->OutputReportLayouts)
            this->SealReportLayouts(this->FeatureReportLayouts)
        }

        define void Indent(i32 Level) {
            for (i32 Index := 0, Index < Level, Index++) {
                Print("  ")
            }
        }

        define void DumpInputItemData(InputItemData Data) {
            i32 Count := MainItemFlag::Last As i32
            
            for (i32 Index := 0, Index < Count, Index++) {
                MainItemFlag Flag := Index As MainItemFlag

                if (Data.HasFlag(Flag)) {
                    Print("%s ", nameof:(Flag))
                }
            }

            Print("\n")
        }

        define void Dump(i32 Level, Collection* Root) {
            this->Indent(Level)
            Print("Collection (%s)\n", nameof:(Root->Info->CollectionData))

            i32 Count := Root->Items->Count()

            for (i32 Index := 0, Index < Count, Index++) {
                CollectionEntry Entry := Root->Items->At(Index) As CollectionEntry

                if (Entry.IsCollection) {
                    this->Dump(Level + 1, Entry.CollectionValue)
                } else {
                    this->Indent(Level + 1)

                    ItemInfo* Info := Entry.ItemValue
                    ItemType Type := Info->Header.Type

                    if (Type = ItemType::Main) {
                        Print("Main Item: %s %b: ", nameof:(Info->Header.MainTag), Info->Value)

                        if (Info->Header.MainTag = MainItemTag::Input) {
                            this->DumpInputItemData(Info->InputData)
                        }
                        else if (Info->Header.MainTag = MainItemTag::Output) {
                            ;this->DumpInputItemData(Level + 1, Info->OutputData)
                        }
                        else if (Info->Header.MainTag = MainItemTag::Feature) {
                            ;this->DumpInputItemData(Level + 1, Info->FeatureData)
                        }
                    }
                    else if (Type = ItemType::Global) {
                        if (Info->Header.GlobalTag = GlobalItemTag::UsagePage) {
                            Print("Global Item: %s %i (%s)\n", nameof:(Info->Header.GlobalTag), Info->Value, USBIDs->GetUsagePageName(Info->Value))
                        } else {
                            Print("Global Item: %s %i\n", nameof:(Info->Header.GlobalTag), Info->Value)
                        }
                    }
                    else if (Type = ItemType::Local) {
                        Print("Local Item: %s %i\n", nameof:(Info->Header.LocalTag), Info->Value)
                    }
                }
            }
        }

        define void Dump() {
            this->Dump(0, this->Root)
        }

        define void New(i8* Bytes, i32 Length) {
            this->Bytes := Bytes
            this->Length := Length
            this->Position := 0

            this->Local := Alloc(#LocalState)
            this->Global := Alloc(#GlobalState)

            this->UsageStack := Alloc(#i32)

            this->InputReportLayouts := new AVLTree(#void*)
            this->OutputReportLayouts := new AVLTree(#void*)
            this->FeatureReportLayouts := new AVLTree(#void*)
        }
    }

    class HumanInputDevice implements IFileHandle, derives INew {
        Device* Base
        InterfaceInfo* Interface

        ReportDescriptorParser* Parser

        define void New(Device* Base, InterfaceInfo* Info) {
            this->Base := Base
            this->Interface := Info

            Descriptor* HID := Info->HIDDescriptors->At(0) As void*

            Print("HID Descriptor: Version %x, Country Code %x, Sub Descriptor Count %i\n",
                HID->SpecificationVersion,
                HID->CountryCode, HID->SubDescriptorCount
            )

            i32 ReportDescriptorLength := 0
            void* ReportDescriptor := null

            for (i32 SubDescriptorIndex := 0, SubDescriptorIndex < HID->SubDescriptorCount, SubDescriptorIndex++) {
                HID::SubDescriptor* Sub := HID->Descriptors[SubDescriptorIndex]

                Print("  Sub Descriptor %i: Type %x, Size %i\n", SubDescriptorIndex, Sub->Type, Sub->Size)

                ReportDescriptorLength := Sub->Size
                ReportDescriptor := Base->GetDescriptorWithLength(0, USB::DescriptorType::HID_Report, 0, ReportDescriptorLength)    

                Print("HID Report Descriptor:\n%hexdump\n", ReportDescriptor, ReportDescriptorLength)
                Info("HID Report Descriptor:\n%hexdump\n", ReportDescriptor, ReportDescriptorLength)
            }

            this->Parser := new ReportDescriptorParser(ReportDescriptor, ReportDescriptorLength)

            this->Parser->Parse()
            this->Parser->Execute()
        }

        define IPeriodicTransferHandle* ScheduleInputReports() {
            EndpointInfo* Endpoint := this->Interface->Endpoints->At(0)
            
            return this->Base->ScheduleInterruptTransfer(Endpoint->Number, RequestDataPhaseDirection::DeviceToHost, 64, Endpoint~>Descriptor->Interval)
        }
    }

    class ProtocolDriver implements USB::IDriver, derives INew {
        define i8* Name() {
            return "USB::HID::HumanInputDevice Dummy Interface Driver"
        }

        PointerArray* Devices ; <HumanInputDevice*>

        define void New() {
            this->Devices := PointerArray:New()
        }

        define InterfaceMatchResult MatchInterface(USB::Device* Base, InterfaceInfo* Interface) {
            if (Interface->HIDDescriptors->Count() = 0) {
                return InterfaceMatchResult::None
            }

            if (Interface~>Descriptor->Class = USB_CLASS_HID) {
                return InterfaceMatchResult::ClassMatch
            }

            return InterfaceMatchResult::None
        }

        define void* AttachInterface(USB::Device* Base, InterfaceInfo* Interface) {
            HumanInputDevice* HID := new HumanInputDevice(Base, Interface)

            this->Devices->Push(HID)

            return HID
        }
    }
}

USB::HID::ProtocolDriver* USB_HID_PROTOCOL_DRIVER := new USB::HID::ProtocolDriver()
i32 USB_HID_PROTOCOL_DRIVER_ID := RegisterUSBDriver(USB_HID_PROTOCOL_DRIVER)

#Require "./src/drivers/USB/Keyboard.rlx"
