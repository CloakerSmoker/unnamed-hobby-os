                            Print("HID Report Descriptor: %hexdump\n", ReportDescriptor, ReportDescriptorLength)
                            Info("HID Report Descriptor: %hexdump\n", ReportDescriptor, ReportDescriptorLength)

                            HID::DescriptorParser* Parser := new HID::DescriptorParser(ReportDescriptor, ReportDescriptorLength)

                            Parser->Parse()
                            Parser->Dump()

                            Parser->Execute()

                            i32 InputCount := Parser->InputReportLayouts->Count()
                            Info("HID Parser found %i input reports\n", InputCount)

                            HID::ReportLayout* Layout := Parser->InputReportLayouts->PointerAt(0)

                            Info("First input report layout: ID %i, Size %i bits, %i fields\n", Layout->ID, Layout->Size, Layout->Fields->Count())

                            PrimaryDisplay->Clear(0x00_00_00)

                            i32 Count := Layout->Fields->Count()

                            for (i32 FieldIndex := 0, FieldIndex < Count, FieldIndex++) {
                                HID::ReportField* Field := Layout->Fields->At(FieldIndex)
                                HID::MainItem* Item := Field->Item

                                Info("Field %i: UsagePage %s, Usage %s, Size %i bits, Offset %i bits\n", FieldIndex, USBIDs->GetUsagePageName(Item->UsagePage), USBIDs->GetUsageName(Item->UsagePage, Item->Usage), Item->ReportSize , Field->Offset)
                            }

                            IPeriodicTransferHandle* PH := this->Controller->ScheduleInterruptTransfer(this->Address, 1, this->Speed, RequestDataPhaseDirection::DeviceToHost, 8);

                            i32 MX := 500
                            i32 MY := 500

                            loop {
                                Layout->Buffer := PH->Wait()

                                Print("\e[H")

                                i64 Report := *(Layout->Buffer As i64*)

                                for (i32 Bit := 0, Bit < Layout->Size, Bit++) {
                                    if (Bit % 8 = 0) {
                                        Print(" ")
                                    }

                                    if (Report & (1 << Bit)) {
                                        Print("1")
                                    }
                                    else {
                                        Print("0")
                                    }
                                }

                                Print("\n%hexdump\n", Layout->Buffer, Layout->Size / 8)

                                i32 Count := Layout->Fields->Count()

                                for (i32 FieldIndex := 0, FieldIndex < Count, FieldIndex++) {
                                    HID::ReportField* Field := Layout->Fields->At(FieldIndex)
                                    HID::MainItem* Item := Field->Item
                                    HID::ItemInfo* Info := Item->Info
                                    HID::InputItemData Data := Info->InputData

                                    i64 Value := Layout->Read(Field)

                                    Print("Field %i: UsagePage %s", FieldIndex, USBIDs->GetUsagePageName(Item->UsagePage))

                                    if (Data.HasFlag(HID::MainItemFlag::Array)) {
                                        Print(" = Usage %s", USBIDs->GetUsageName(Item->UsagePage, Value As i32))
                                    }
                                    else {
                                        Print("Usage %s = %i", USBIDs->GetUsageName(Item->UsagePage, Item->Usage), Value)
                                    }

                                    Print("\e[0K\n")
                                }

                                PrimaryDisplay->DrawRectangle(MX, MY, 10, 10, 0x00_00_00)
                                MX += Layout->Read(Layout->Fields->At(6)) As i32
                                MY += Layout->Read(Layout->Fields->At(7)) As i32

                                if (MX < 0) { MX := 0 }
                                if (MY < 0) { MY := 0 }
                                if (MX + 10 > 1024) { MX := 1024 - 10 }
                                if (MY + 10 > 768) { MY := 768 - 10 }

                                PrimaryDisplay->DrawRectangle(MX, MY, 10, 10, 0xFF_FF_FF)


                                ;Print("HID Report:\n%hexdump\n", Layout->Buffer, Layout->Size / 8)
                            }

                            this->Controller->Stop()
                            Halt()
                        } */
                    }
                    else {
                        Print("Unknown USB descriptor type %x at offset %i\n", Header->Type, Offset)
                    }

                    Print("%usb-descriptor", Header)

                    Offset += ((Header->Length As i32) & 0xFF)
                }

                ; Group endpoints by interface

                i32 InterfaceCount := Configuration->Interfaces->Count()
                i32 EndpointIndex := 0

                for (i32 InterfaceIndex := 0, InterfaceIndex < InterfaceCount, InterfaceIndex++) {
                    InterfaceInfo* Interface := Configuration->Interfaces->At(InterfaceIndex)
                    Interface->EndpointBase = EndpointIndex

                    i32 EndpointCount := Interface~>Descriptor->EndpointCount

                    for (i32 InnerEndpointIndex := 0, InnerEndpointIndex < EndpointCount, InnerEndpointIndex++) {
                        EndpointInfo* Endpoint := Configuration->Endpoints->At(EndpointIndex + InnerEndpointIndex)

                        Print("Interface %i owns endpoint %i\n", InterfaceIndex, Endpoint->Number)

                        Interface->Endpoints->Push(Endpoint)
                    }

                    EndpointIndex += EndpointCount
                }

                break
            }

            i32 ConfigurationCount := this->Descriptor->ConfigurationCount

            for (i32 ConfigurationIndex := 0, ConfigurationIndex < ConfigurationCount, ConfigurationIndex++) {
                ConfigurationInfo* Configuration := this->Configurations->At(ConfigurationIndex)

                Print("Configuration %i '%usb-string-descriptor':\n", ConfigurationIndex, Configuration->DescriptionString)

                i32 InterfaceCount := Configuration->Interfaces->Count()

                for (i32 InterfaceIndex := 0, InterfaceIndex < InterfaceCount, InterfaceIndex++) {
                    InterfaceInfo* Interface := Configuration->Interfaces->At(InterfaceIndex)

                    Print("\tInterface %i '%usb-string-descriptor':\n", InterfaceIndex, Interface->InterfaceString)

                    i32 EndpointCount := Interface->Endpoints->Count()

                    for (i32 EndpointIndex := 0, EndpointIndex < EndpointCount, EndpointIndex++) {
                        EndpointInfo* Endpoint := Interface->Endpoints->At(EndpointIndex)

                        Print("\t\t\tEndpoint %i: %s %s\n", EndpointIndex, nameof:(Endpoint~>Descriptor->Direction), nameof:(Endpoint~>Descriptor->Attributes))
                    }
                }
            }

            Print("Selecting configuration 0\n")

            this~>Setup->MakeSetConfiguration(0)
            this->SendControlTransferToDevice(this~>Setup, null, 0)->Wait()->Free()

            this->CurrentConfiguration := this->Configurations->At(0)
        }
    }

    interface IBinding {
        virtual IBinding* GetDriver()
    }

    enum DeviceMatchResult {
        None := 0,
        VendorProductMatch := 1
    }

    enum InterfaceMatchResult {
        None := 0,
        ClassMatch := 1,
        ClassSubclassMatch := 2,
        ClassSubclassProtocolMatch := 3
    }

    interface IDriver {
        virtual i8* Name()

        virtual DeviceMatchResult Match(Device* Attached) {
            return DeviceMatchResult::None
        }

        virtual InterfaceMatchResult MatchInterface(Device* Attached, InterfaceInfo* Info) {
            return InterfaceMatchResult::None
        }

        virtual void* Attach(Device* Attached) {
            return null
        }
        virtual void* AttachInterface(Device* Attached, InterfaceInfo* Info) {
            return null
        }

        virtual void Remove(Device* Removed) {
            ; Default implementation does nothing
        }
        virtual void RemoveInterface(Device* Removed, InterfaceInfo* Info) {
            ; Default implementation does nothing
        }
    }

    class Bus derives INew {
        i32 BusNumber
        IController* Controller

        i32 NextAddress

        PointerArray* Devices ; <Device*>

        define void New(i32 BusNumber) {
            this->BusNumber := BusNumber

            this->NextAddress := 1
            this->Devices := PointerArray:New()
        }

        define i32 AssignAddress() {
            return this->NextAddress++
        }

        define Device* Attach(i32 Address) {
            Device* Attached := new Device(this->Controller, Address)
            DeviceDescriptor* AttachedDescriptor := Attached->Descriptor

            Print("What a wonderful %s %s you have plugged in !!!!!!\n", 
                USBIDs->GetVendorName(AttachedDescriptor->VendorID),
                USBIDs->GetDeviceName(AttachedDescriptor->VendorID, AttachedDescriptor->ProductID)
            )

            Print("USB Device Strings:\n")
            Print("  Manufacturer: %usb-string-descriptor\n", Attached->ManufacturerString)
            Print("  Product: %usb-string-descriptor\n", Attached->ProductString)
            Print("  Serial Number: %usb-string-descriptor\n", Attached->SerialNumberString)

            this->Devices->Push(Attached)
            
            i32 Count := USB_DRIVERS->Count()

            IDriver* BestDeviceMatch := null

            for (i32 Index := 0, Index < Count, Index++) {
                IDriver* Driver := USB_DRIVERS->At(Index)

                if (Driver->Match(Attached) != DeviceMatchResult::None) {
                    if (BestDeviceMatch) {
                        BestDeviceMatch := null ; Conflicting drivers registered
                    }
                    else {
                        BestDeviceMatch := Driver
                    }
                }
            }

            if (BestDeviceMatch) {
                Print("Bound device %i to driver %s\n", Address, BestDeviceMatch->Name())

                Attached->DriverData := BestDeviceMatch->Attach(Attached)
            }
            else {
                i32 InterfaceCount := Attached->CurrentConfiguration->Interfaces->Count()

                for (i32 InterfaceIndex := 0, InterfaceIndex < InterfaceCount, InterfaceIndex++) {
                    InterfaceInfo* Interface := Attached->CurrentConfiguration->Interfaces->At(InterfaceIndex)

                    IDriver* BestInterfaceMatch := null
                    InterfaceMatchResult BestMatchResult := InterfaceMatchResult::None

                    for (i32 Index := 0, Index < Count, Index++) {
                        IDriver* Driver := USB_DRIVERS->At(Index)

                        InterfaceMatchResult Result := Driver->MatchInterface(Attached, Interface)

                        Print("For Interface %i, driver %s returned match result %i\n", InterfaceIndex, Driver->Name(), Result)

                        if (Result > BestMatchResult) {
                            BestInterfaceMatch := Driver
                            BestMatchResult := Result
                        }
                    }

                    if (BestInterfaceMatch) {
                        Print("Bound interface %i of device %i to driver %s\n", InterfaceIndex, Address, BestInterfaceMatch->Name())

                        Interface->DriverData := BestInterfaceMatch->AttachInterface(Attached, Interface)
                    }
                    else {
                        Print("No driver found for interface %i of device %i\n", InterfaceIndex, Attached->Address)
                    }
                }
            }

            return Attached
        }
        define void Remove(i32 Address) {

        }
    }
}

define i32 RegisterUSBDriver(USB::IDriver* Driver) {
    i32 ID := USB_DRIVERS->Count()
    USB_DRIVERS->Push(Driver)

    return ID
}

#Require "src/drivers/USB/Hub.rlx"

#Require "src/drivers/USB/HID.rlx"
