
#Require "src/drivers/USB/Packets.rlx"

i8 PCI_SUBCLASS_USB_CONTROLLER := 0x3
i8 PCI_INTERFACE_EHCI := 0x20

PointerArray* USB_DRIVERS := PointerArray:New() ; <USB::IDriver*>

namespace USB {
    enum TransferSpeed {
        Full := 0,
        Low := 1,
        High := 2,
        Super := 3
    }

    struct ControllerDevice {
        i8 dummy
    }

    struct EndpointInfo {
        EndpointDescriptor Descriptor
        i32 Number
        i8 Toggle

        static self* New(DescriptorHeader* Descriptor) {
            self* this := Alloc(#self)

            if (Descriptor != null) {
                MoveMemory(this~>Descriptor, Descriptor, #EndpointDescriptor)
                this->Number := this~>Descriptor->Number & 0x0F
            }

            return this
        }
    }

    struct InterfaceInfo {
        InterfaceDescriptor Descriptor
        i32 Number
        StringDescriptor* InterfaceString

        PointerArray* HIDDescriptors ; <DescriptorHeader*>

        PointerArray* Endpoints ; <EndpointInfo*>
        i32 EndpointBase

        void* DriverData

        static self* New(i32 Number, DescriptorHeader* Descriptor, StringDescriptor* InterfaceString) {
            self* this := Alloc(#self)

            this->Number := Number

            MoveMemory(this~>Descriptor, Descriptor, #InterfaceDescriptor)
            this->InterfaceString := InterfaceString

            this->HIDDescriptors := PointerArray:New()

            this->Endpoints := PointerArray:New()

            return this
        }

        define i8 Is(i32 Class, i32 SubClass, i32 Protocol) {
            return this~>Descriptor->Class = Class && this~>Descriptor->SubClass = SubClass && this~>Descriptor->Protocol = Protocol
        }
        define i8 Is(i32 Class, i32 SubClass) {
            return this~>Descriptor->Class = Class && this~>Descriptor->SubClass = SubClass
        }
        define i8 Is(i32 Class) {
            return this~>Descriptor->Class = Class
        }
    }

    struct ConfigurationInfo {
        ConfigurationDescriptor Descriptor
        StringDescriptor* DescriptionString

        PointerArray* Interfaces ; <InterfaceInfo*>
        PointerArray* Endpoints ; <EndpointInfo*>

        static self* New(DescriptorHeader* Descriptor, StringDescriptor* DescriptionString) {
            self* this := Alloc(#self)
            
            MoveMemory(this~>Descriptor, Descriptor, #ConfigurationDescriptor)
            this->DescriptionString := DescriptionString

            this->Interfaces := PointerArray:New()
            this->Endpoints := PointerArray:New()

            return this
        }
    }

    interface ITransferHandle {
        virtual ITransferHandle* Wait()
        virtual void Free()
    }

    interface IPeriodicTransferHandle {
        virtual void* Wait()
        virtual void Stop()
        virtual void Free()

        virtual i32 TransferredLength()
    }

    interface IController {
        virtual Bus* GetBus()

        virtual ITransferHandle* SendControlTransfer(i32, i32, TransferSpeed, SetupPacket*, void*, i32)
        virtual IPeriodicTransferHandle* ScheduleInterruptTransfer(i32, i32, TransferSpeed, RequestDataPhaseDirection, i32)
        virtual void Free(ITransferHandle*)

        virtual void Stop()
    }

    class Device derives INew {
        IController* Controller

        SetupPacket Setup

        DeviceDescriptor* Descriptor

        StringDescriptor* ManufacturerString
        StringDescriptor* ProductString
        StringDescriptor* SerialNumberString

        i32 NumberOfLanguageIDs
        LanguageID* LanguageIDs

        i32 Address
        TransferSpeed Speed

        EndpointInfo* ControlEndpoint

        PointerArray* Configurations ; <ConfigurationInfo*>
        ConfigurationInfo* CurrentConfiguration

        void* DriverData

        define ITransferHandle* SendControlTransfer(SetupPacket* Setup, void* Buffer, i32 Length) {
            return this->Controller->SendControlTransfer(this->Address, 0, this->Speed, Setup, Buffer, Length)
        }

        define ITransferHandle* SendControlTransferToDevice(SetupPacket* Setup, void* Buffer, i32 Length) {
            Setup->Recipient := RequestRecipient::Device

            return this->Controller->SendControlTransfer(this->Address, 0, this->Speed, Setup, Buffer, Length)
        }

        define ITransferHandle* SendControlTransferToEndpoint(i32 Endpoint, SetupPacket* Setup, void* Buffer, i32 Length) {
            Setup->Recipient := RequestRecipient::Endpoint
            Setup->Index := Endpoint As i16

            return this->Controller->SendControlTransfer(this->Address, 0, this->Speed, Setup, Buffer, Length)
        }

        define ITransferHandle* SendControlTransferToInterface(i32 Interface, SetupPacket* Setup, void* Buffer, i32 Length) {
            Setup->Recipient := RequestRecipient::Interface
            Setup->Index := Interface As i16

            return this->Controller->SendControlTransfer(this->Address, 0, this->Speed, Setup, Buffer, Length)
        }

        define void* GetDescriptorWithLength(i32 InterfaceNumber, USB::DescriptorType Type, LanguageID Language, i8 Index, i32 Length) {
            void* Buffer := Alloc(Length)
            this~>Setup->MakeGetDescriptor(Type, Language, Index, Length As i16)

            if (InterfaceNumber != -1) {
                this->SendControlTransferToInterface(InterfaceNumber, this~>Setup, Buffer, Length)->Wait()->Free()
            }
            else {
                this->SendControlTransferToDevice(this~>Setup, Buffer, Length)->Wait()->Free()
            }

            return Buffer
        }
        define void* GetDescriptorWithLength(i32 InterfaceNumber, USB::DescriptorType Type, i8 Index, i32 Length) {
            return this->GetDescriptorWithLength(InterfaceNumber, Type, LanguageID::None, Index, Length)
        }

        define void* GetDescriptor(i32 InterfaceNumber, USB::DescriptorType Type, LanguageID Language, i8 Index, i32* OutLength) {
            i64 HeaderBuffer := 0
            DescriptorHeader* Header := &HeaderBuffer As DescriptorHeader*
            
            this~>Setup->MakeGetDescriptor(Type, Language, Index, 8)

            if (InterfaceNumber != -1) {
                this->SendControlTransferToInterface(InterfaceNumber, this~>Setup, Header, 8)->Wait()->Free()
            }
            else {
                this->SendControlTransferToDevice(this~>Setup, Header, 8)->Wait()->Free()
            }

            i32 Length := Header->Length

            if (Type = USB::DescriptorType::Configuration) {
                Length := (Header As ConfigurationDescriptor*)->TotalLength
            }

            if (OutLength != null) {
                *OutLength := Length
            }

            return this->GetDescriptorWithLength(InterfaceNumber, Type, Language, Index, Length)
        }
        define void* GetDescriptor(i32 InterfaceNumber, USB::DescriptorType Type, i8 Index, i32* OutLength) {
            return this->GetDescriptor(InterfaceNumber, Type, LanguageID::None, Index, OutLength)
        }
        define void* GetDescriptor(i32 InterfaceNumber, USB::DescriptorType Type, i8 Index) {
            return this->GetDescriptor(InterfaceNumber, Type, LanguageID::None, Index, null)
        }
        define void* GetDescriptor(USB::DescriptorType Type, LanguageID Language, i8 Index) {
            return this->GetDescriptor(-1, Type, Language, Index, null)
        }
        define void* GetDescriptor(USB::DescriptorType Type, i8 Index, i32* OutLength) {
            return this->GetDescriptor(-1, Type, LanguageID::None, Index, OutLength)
        }
        define void* GetDescriptor(USB::DescriptorType Type, i8 Index) {
            return this->GetDescriptor(-1, Type, LanguageID::None, Index, null)
        }

        define StringDescriptor* GetStringDescriptor(LanguageID Language, i8 Index) {
            if (Index != 0) {
                return this->GetDescriptor(USB::DescriptorType::String, Language, Index)
            }

            return null
        }

        define IPeriodicTransferHandle* ScheduleInterruptTransfer(i32 Endpoint, RequestDataPhaseDirection Direction, i32 PollingInterval) {
            return this->Controller->ScheduleInterruptTransfer(this->Address, Endpoint, this->Speed, Direction, PollingInterval)
        }


        define void New(IController* Controller, i32 Address) {
            this->Controller := Controller
            this->Address := Address

            this->ControlEndpoint := new EndpointInfo(null)
            this->Configurations := PointerArray:New()

            this->Speed := TransferSpeed::Low

            this->Descriptor := this->GetDescriptor(USB::DescriptorType::Device, 0)
            
            this->ManufacturerString := this->GetStringDescriptor(LanguageID::EnglishUS, this->Descriptor->ManufacturerStringIndex)
            this->ProductString := this->GetStringDescriptor(LanguageID::EnglishUS, this->Descriptor->ProductStringIndex)
            this->SerialNumberString := this->GetStringDescriptor(LanguageID::EnglishUS, this->Descriptor->SerialNumberStringIndex)

            Print("USB Device Strings:\n")
            Print("  Manufacturer: %usb-string-descriptor\n", this->ManufacturerString)
            Print("  Product: %usb-string-descriptor\n", this->ProductString)
            Print("  Serial Number: %usb-string-descriptor\n", this->SerialNumberString)

            i32 StringDescriptorZeroLength := 0
            this->LanguageIDs := this->GetDescriptor(USB::DescriptorType::String, 0, &StringDescriptorZeroLength) + 2
            this->NumberOfLanguageIDs := (StringDescriptorZeroLength - 2) / 2

            for (i8 Index := 0, Index < this->Descriptor->ConfigurationCount, Index++) {
                i32 Length := 0
                void* Buffer := this->GetDescriptor(USB::DescriptorType::Configuration, Index, &Length)

                ConfigurationDescriptor* Descriptor := Buffer As ConfigurationDescriptor*
                ConfigurationInfo* Configuration := new ConfigurationInfo(Buffer, this->GetStringDescriptor(LanguageID::EnglishUS, Descriptor->DescriptionStringIndex))

                this->Configurations->Push(Configuration)

                i32 Offset := Configuration~>Descriptor~>Header->Length
                InterfaceInfo* CurrentInterface := null

                while (Offset < Configuration~>Descriptor->TotalLength) {
                    DescriptorHeader* Header := (Buffer + Offset) As DescriptorHeader*

                    if (Header->Type = USB::DescriptorType::Interface) {
                        InterfaceDescriptor* InterfaceHeader := Header As InterfaceDescriptor*

                        i32 InterfaceNumber := Configuration->Interfaces->Count()
                        CurrentInterface := new InterfaceInfo(InterfaceNumber, Header, this->GetStringDescriptor(LanguageID::EnglishUS, InterfaceHeader->InterfaceStringIndex))

                        Configuration->Interfaces->Push(CurrentInterface)
                    }
                    else if (Header->Type = USB::DescriptorType::Endpoint) {
                        Configuration->Endpoints->Push(new EndpointInfo(Header))
                    }
                    else if (Header->Type = USB::DescriptorType::HID) {
                        CurrentInterface->HIDDescriptors->Push(Header)

                        /* HID::Descriptor* HID := Header As void*

                        Print("HID Descriptor: Version %x, Country Code %x, Sub Descriptor Count %i\n",
                              HID->SpecificationVersion,
                              HID->CountryCode, HID->SubDescriptorCount)

                        for (i32 SubDescriptorIndex := 0, SubDescriptorIndex < HID->SubDescriptorCount, SubDescriptorIndex++) {
                            HID::SubDescriptor* SubDescriptor := HID->Descriptors[SubDescriptorIndex]

                            Print("  Sub Descriptor %i: Type %x, Size %i\n", SubDescriptorIndex, SubDescriptor->Type, SubDescriptor->Size)

                            i32 ReportDescriptorLength := SubDescriptor->Size
