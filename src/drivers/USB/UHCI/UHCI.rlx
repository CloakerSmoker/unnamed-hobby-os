
#Require "src/drivers/USB/Descriptors.rlx"
#Require "src/drivers/USB/IDs.rlx"
#Require "src/drivers/USB/Device.rlx"


i8 PCI_INTERFACE_UHCI := 0

void* FirstUHCIController := null

namespace USB::UHCI {
    namespace RegisterFields {
        bits Command As i16 {
            [0] RunStop
            [1] HostControllerReset
            [2] GlobalReset
            [3] EnterGlobalSuspend
            [4] ForceGlobalResume
            [5] EnableSoftwareDebug
            [6] Configured
            [7] Enable64BitPackets
        }

        bits Status As i16 {
            [0] InterruptWasFromTransfer
            [1] InterruptWasFromError
            [2] ResumeDetected
            [3] HostSystemError
            [4] HostControllerError
            [5] HostControllerHalted
        }

        bits Interrupt As i16 {
            [0] InterruptOnTimerOrCRC
            [1] InterruptOnResume
            [2] InterruptOnComplete
            [3] InterruptOnShortPacket
        }

        bits Port As i16 {
            [0] DevicePresent
            [1] ConnectStatusChange
            [2] Enable
            [3] EnableChange
            [4:5] LineStatus
            [6] ResumeDetected
            [7] Present
            [8] LowSpeedDevice
            [9] Reset
            [12] Suspend
        }
    }

    enum Registers As i32 {
        Command := 0
        Status := 2
        InterruptEnable := 4
        FrameNumber := 6
        FrameListBase := 8
        StartOfFrameModify := 0xC
        Port1 := 0x10
        Port2 := 0x12
    }

    enum TransferToken {
        IN := 0x69,
        OUT := 0xE1,
        SETUP := 0x2D
    }

    struct TransferDescriptor {
        i32 Link

        bits As i32 {
            [0:10] ActualLength
            [17] BitstuffError
            [18] TimeoutOrCRCError
            [19] NAKReceived
            [20] BabbleDetected
            [21] DataBufferError
            [22] Stalled
            [23] Active
            [24] ShouldInterruptOnComplete
            [25] IsIsochronous
            [26] IsLowSpeedDevice
            [27:28] InterruptAfterErrorCount
            [29] ShortPacketDetect
        }

        bits As i32 {
            [21:31] MaximumLength
            [19] DataToggle
            [15:18] Endpoint
            [8:14] DeviceAddress
            TransferToken [0:7] Token
        }

        i32 PhysicalBufferPointer
        void* Buffer

        i64 ScheduledGlobalFrameNumber
    }

    struct QueueHead {
        union {
            i32 HorizontalLink
            i32 Link ; READ ONLY BY HC
        }

        union {
            i32 VerticalLink
            i32 ElementLink ; READ/WRITE BY HC
        }

        i8* Name
        i8 Complete
        Synchronization::Semaphore* Completed
        QueueHead* Previous
        TransferHandle* Handle
    }

    struct PCIeOverlay {
        i8[0x20] _
        i32 IOBase
        ; 0x24
        i8[0x3C] _
        i8 USBVersion
    }

    enum LinkFlags As i32 {
        Terminator := 1,
        IsQueueHead := 2,
        DepthFirst := 4
    }

    enum TransferType {
        Control,
        Bulk
    }

    class TransferHandle implements USB::ITransferHandle, derives INew {
        TransferType Type

        IController* Controller

        SetupPacket* Setup

        RequestDataPhaseDirection DataDirection

        QueueHead* QH
        PointerArray* TDs

        void* OriginalBuffer
        void* RelocatedBuffer
        i32 Size

        Synchronization::Semaphore* Completed
        i32 TransferredSize

        define void New(TransferType Type, IController* Controller, RequestDataPhaseDirection DataDirection, QueueHead* QH, void* OriginalBuffer, void* RelocatedBuffer, i32 Size) {
            this->Type := Type
            this->DataDirection := DataDirection

            this->Controller := Controller

            this->QH := QH
            this->TDs := new PointerArray()

            this->OriginalBuffer := OriginalBuffer
            this->RelocatedBuffer := RelocatedBuffer
            this->Size := Size

            this->Completed := new Synchronization::Semaphore(FormatString("%s Completed", this->QH->Name), 0)

            this->QH->Handle := this
        }

        define void New(IController* Controller, SetupPacket* Setup, QueueHead* QH, void* OriginalBuffer, void* RelocatedBuffer) {
            this->Setup := Setup
            
            this->New(TransferType::Control, Controller, Setup->DataDirection, QH, OriginalBuffer, RelocatedBuffer, Setup->Length)
        }

        define void New(IController* Controller, RequestDataPhaseDirection Direction, QueueHead* QH, void* OriginalBuffer, void* RelocatedBuffer, i32 Size) {
            this->New(TransferType::Bulk, Controller, Direction, QH, OriginalBuffer, RelocatedBuffer, Size)
        }

        define void AddTransferDescriptor(TransferDescriptor* TD) {
            this->TDs->Add(TD)
        }

        define void* Read(i32* OutSize) {
            return null
        }

        define void Complete() {
            this->QH->Complete := true

            if (this->DataDirection = RequestDataPhaseDirection::DeviceToHost) {
                void* Buffer := this->OriginalBuffer
                i32 Count := this->TDs->Count()

                for (i32 Index := 0, Index < Count, Index++) {
                    TransferDescriptor* TD := this->TDs->At(Index)

                    if (TD->Token != TransferToken::IN) {
                        continue
                    }

                    i32 Size := TD->ActualLength + 1

                    MoveMemory(Buffer, TD->Buffer, Size)

                    this->TransferredSize += Size
                    Buffer += Size
                }
            }

            this->Completed->Signal()
        }

        define ITransferHandle* Wait() {
            this->Completed->Wait()

            return this
        }

        define void Free() {
            this->Controller->Free(this)
            this->TDs->Free()
            this->Completed->Free()
            this->Delete()
        }
    }

    enum PeriodicTransferType {
        Interrupt,
        Isochronous
    }

    class PeriodicTransferHandle implements USB::IPeriodicTransferHandle, derives INew {
        IController* Controller

        i8* Name
        
        TransferSpeed Speed
        PeriodicTransferType Type
        TransferToken Token
        i32 Address
        i32 Endpoint

        i32 Period
        i32 Phase

        i32 SingleTransferSize
        i32 SingleTransferBandwidth ; Guesstimate in bytes

        ; These swap role based on token
        ; IN  - FilledBuffers are filled by device, FreeBuffers are empty
        ;       driver consumes filled buffers and returns them to free
        ; OUT - FilledBuffers are filled by driver, FreeBuffers are empty
        ;       driver consumes free buffers and returns them to free
        
        Synchronization::Lock* TransferDescriptorsLock
        PointerArray* FilledTransferDescriptors
        PointerArray* ScheduledTransferDescriptors
        PointerArray* FreeTransferDescriptors

        Synchronization::Semaphore* FilledCount
        Synchronization::Semaphore* ScheduledCount
        Synchronization::Semaphore* FreeCount

        ; Pretty sure there's a compiler bug here when INew is derived
        ;  and there's a `define void New(...)` method with lots of parameters

        define void New(IController* Controller) {
            this->Controller := Controller
            
            this->FreeTransferDescriptors := new PointerArray()
            this->ScheduledTransferDescriptors := new PointerArray()
            this->FilledTransferDescriptors := new PointerArray()
        }

        define void DescribeTransfer(TransferSpeed Speed, PeriodicTransferType Type, TransferToken Token, i32 SingleTransferSize, i32 Address, i32 Endpoint) {
            this->Speed := Speed
            this->Type := Type
            this->Token := Token
            this->SingleTransferSize := SingleTransferSize
            this->Address := Address
            this->Endpoint := Endpoint

            ; Guesstimate bandwidth usage of non-payload data as 32 bytes
            this->SingleTransferBandwidth := 32

            if (Speed = TransferSpeed::Low) {
                ; Guess low speed transfers as taking 8x longer

                this->SingleTransferBandwidth += (SingleTransferSize * 8)
            }
            else {
                this->SingleTransferBandwidth += SingleTransferSize
            }
        }

        define void DescribeTiming(i32 Period, i32 Phase) {
            this->Period := Period
            this->Phase := Phase

            this->Name := FormatString("%s %s %s WITH %i.%i",
                nameof:(this->Speed),
                nameof:(this->Type),
                nameof:(this->Token),
                this->Address,
                this->Endpoint
            )

            this->TransferDescriptorsLock := new Synchronization::Lock(FormatString("%s Lock", this->Name))

            this->FilledCount := new Synchronization::Semaphore(FormatString("%s FilledCount", this->Name), 0)
            this->ScheduledCount := new Synchronization::Semaphore(FormatString("%s ScheduledCount", this->Name), 0)
            this->FreeCount := new Synchronization::Semaphore(FormatString("%s FreeCount", this->Name), 0)
        }

        define void ProvideTransferDescriptor(TransferDescriptor* TD) {
            this->TransferDescriptorsLock->Acquire()
            this->FreeTransferDescriptors->Push(TD)
            this->FreeCount->Increment()
            this->TransferDescriptorsLock->Release()
        }

        define void DumpStatus() {
            this->TransferDescriptorsLock->Acquire()

            Info("%s Free TDs: %i\n", this->Name, this->FreeTransferDescriptors->Count())
            Info("%s Scheduled TDs: %i\n", this->Name, this->ScheduledTransferDescriptors->Count())
            Info("%s Filled TDs: %i\n", this->Name, this->FilledTransferDescriptors->Count())

            this->TransferDescriptorsLock->Release()
        }

        define TransferDescriptor* ScheduleOutgoingTransferDescriptor() {
            this->TransferDescriptorsLock->Acquire()

            TransferDescriptor* Result := null

            if (this->Token = TransferToken::IN) {
                if (this->FreeTransferDescriptors->Count() = 0) {
                    Panic(FormatString("UHCI: %s: No free transfer descriptors available for periodic IN transfer!", this->Name))
                }

                Result := this->FreeTransferDescriptors->Pop()
                this->FreeCount->Decrement()
            }
            else if (this->Token = TransferToken::OUT) {
                if (this->FilledTransferDescriptors->Count() = 0) {
                    Panic(FormatString("UHCI: %s: No filled transfer descriptors available for periodic OUT transfer!", this->Name))
                }

                Result := this->FilledTransferDescriptors->Pop()
                this->FilledCount->Decrement()
            }

            FastZeroMemory(Result->Buffer, this->SingleTransferSize)
            Result->MaximumLength := (this->SingleTransferSize - 1) As i16
            Result->ActualLength := 0
            Result->Active := true

            this->ScheduledTransferDescriptors->Push(Result)
            this->ScheduledCount->Increment()

            this->TransferDescriptorsLock->Release()

            return Result
        }

        define void RetireTransferDescriptor(TransferDescriptor* TD) {
            this->TransferDescriptorsLock->Acquire()

            this->ScheduledTransferDescriptors->RemoveValue(TD)
            this->ScheduledCount->Decrement()

            if (TD->ActualLength = 0) {
                ; No data was transferred, return buffer to free/uninitialized pool

                if (this->Token = TransferToken::IN) {
                    this->FreeTransferDescriptors->Push(TD)
                    this->FreeCount->Increment()
                }
            }
            else {
                if (this->Token = TransferToken::IN) {
                    this->FilledTransferDescriptors->Push(TD)
                    this->FilledCount->Increment()
                }
                else if (this->Token = TransferToken::OUT) {
                    this->FreeTransferDescriptors->Push(TD)
                    this->FreeCount->Increment()
                }
            }

            this->TransferDescriptorsLock->Release()
        }

        define i32 Write(void* Data, i8 NonBlocking) {
            if (this->Token != TransferToken::OUT) {
                Panic("UHCI: Attempted to write to non-OUT periodic transfer!")
            }

            i32 Timeout := 0

            if (NonBlocking) {
                Timeout := -1
            }

            if (this->FreeCount->Wait(Timeout)) {
                ; We have a free transfer descriptor

                this->TransferDescriptorsLock->Acquire()

                TransferDescriptor* TD := this->FreeTransferDescriptors->Pop()

                MoveMemory(TD->Buffer, Data, this->SingleTransferSize)

                this->FilledTransferDescriptors->Push(TD)
                this->FilledCount->Increment()

                this->TransferDescriptorsLock->Release()
            }
            else {
                return 0
            }

            return this->SingleTransferSize
        }

        define i32 Read(void* Data, i8 NonBlocking) {
            if (this->Token != TransferToken::IN) {
                Panic("UHCI: Attempted to read from non-IN periodic transfer!")
            }

            i32 Timeout := 0

            if (NonBlocking) {
                Timeout := -1
            }

            i32 Size := 0

            if (this->FilledCount->Wait(Timeout)) {
                ; We have a filled transfer descriptor to consume

                this->TransferDescriptorsLock->Acquire()

                i32 Count := this->FilledTransferDescriptors->Count()

                if (Count != 1) {
                    ;Info("More than one TD available to read\n")

                    for (i32 Index := 0, Index < Count, Index++) {
                        TransferDescriptor* TD := this->FilledTransferDescriptors->At(Index)

                        ;Info("TD %i: %x, GFN %i\n", Index, TD, TD->ScheduledGlobalFrameNumber)
                    }
                }

                ; Select the oldest TD (the one with the lowest scheduled global frame number) to read
                ;  we have to do this because Controller.RetireSinglePeriodicTransfer sucks
                ;   and enumerates while modifying and goes backwards

                TransferDescriptor* FirstTD := this->FilledTransferDescriptors->At(0)

                for (i32 Index := 0, Index < Count, Index++) {
                    TransferDescriptor* TD := this->FilledTransferDescriptors->At(Index)

                    if (TD->ScheduledGlobalFrameNumber < FirstTD->ScheduledGlobalFrameNumber) {
                        FirstTD := TD
                    }
                }

                this->FilledTransferDescriptors->RemoveValue(FirstTD)

                Size := FirstTD->ActualLength + 1

                MoveMemory(Data, FirstTD->Buffer, Size)

                Info("RR %x (buf: %x) @ %i: ", FirstTD, FirstTD->Buffer, FirstTD->ScheduledGlobalFrameNumber)

                i8* Bytes := FirstTD->Buffer

                for (i32 Index := 0, Index < Size, Index++) {
                    Info(" %X", Bytes[Index])
                }

                Info("\n")

                this->FreeTransferDescriptors->Push(FirstTD)
                this->FreeCount->Increment()

                this->TransferDescriptorsLock->Release()
            }
            else {
                return 0
            }

            return Size
        }


        
        define void Free() {

        }

        define void Stop() {
            
        }


    }


    

    class Controller implements USB::IController, derives INew {
        PCIeAddress* Address
        PCIeDevice* Device

        PalHeap* Heap

        void* HeapPoolVirtual
        i64 HeapPoolPhysical

        QueueHead* ControlTransferQueue
        QueueHead* BulkTransferQueue

        PointerArray* QueueHeadsInFlight ; Control and bulk transfers waiting for completion, scheduled via their respective QH
        
        PointerArray* IsochronousTransfers
        PointerArray* InterruptTransfers

        i32 IOBase
        i8 USBVersion

        i32* FrameList
        i64 PhysicalFrameList

        Synchronization::Semaphore* Interrupt

        USB::Bus* Bus

        define void New(PCIeAddress* Address, PCIeDevice* _Device, USB::Bus* _Bus) {
            this->Address := Address
            this->Device := _Device
            this->Bus := _Bus

            _Bus->Controller := this

            this->Interrupt := new Synchronization::Semaphore("UHCI Interrupt", 0)

            FirstUHCIController := this

            PCIeOverlay* Overlay := _Device As void*

            this->IOBase := _Device->ReadBAR(4)
            this->USBVersion := Overlay->USBVersion

            Print("UCHI IOBase %x, Version %x\n", this->IOBase, this->USBVersion)

            this->QueueHeadsInFlight := new PointerArray()
            this->InterruptTransfers := new PointerArray()
            this->IsochronousTransfers := new PointerArray()
        }

        define USB::Bus* GetBus() {
            return this->Bus
        }

        define void Write16(Registers Target, i16 Value) {
            OutW((this->IOBase + (Target As i32)) As i16, Value)
        }
        define void Write32(Registers Target, i32 Value) {
            OutL((this->IOBase + (Target As i32)) As i16, Value)
        }

        define i16 Read16(Registers Target) {
            return InW((this->IOBase + (Target As i32)) As i16)
        }

        define i32 Read32(Registers Target) {
            return InL((this->IOBase + (Target As i32)) As i16)
        }

        define i32 VirtualToPhysical(void* Virtual) {
            return ((Virtual As i64) - (this->HeapPoolVirtual As i64) + this->HeapPoolPhysical) As i32
        }
        define void* PhysicalToVirtual(i32 Physical) {
            return ((Physical As i64) - this->HeapPoolPhysical + (this->HeapPoolVirtual As i64)) As void*
        }

        define i32 PackLink(void* VirtualAddress, ... Flags) {
            i32 Packed := 0

            if (VirtualAddress != null) {
                Packed := this->VirtualToPhysical(VirtualAddress)
            }

            i32 FlagCount := Flags[0] As i32

            for (i32 Index := 0, Index < FlagCount, Index++) {
                Packed |= Flags[Index + 1] As i32
            }

            return Packed
        }

        define i32 RemoveLinkFlag(i32 Link, LinkFlags Flag) {
            return Link & ~(Flag As i32)
        }

        define i32 AddLinkFlag(i32 Link, LinkFlags Flag) {
            return Link | (Flag As i32)
        }

        define void Indent(i32 Count) {
            for (i32 Index := 0, Index < Count, Index++) {
                Info("  ")
            }
        }

        define void DumpLink(i32 Indent, i32 Link) {
            if (Link & 1) {
                Info("%x Terminator\n", Link)
            }
            else if (Link & 2) {
                QueueHead* Queue := this->PhysicalToVirtual(Link & 0x7FFF_FFF0)

                Info("%x %s QueueHead -> ", Link, Queue->Name)

                this->DumpLink(Indent, Queue->VerticalLink)

                this->Indent(Indent + 1)
                Info(" %c-> ", '^')
                this->DumpLink(Indent + 1, Queue->HorizontalLink)
            }
            else {
                TransferDescriptor* TD := this->PhysicalToVirtual(Link & 0x7FFF_FFF0)

                Info("%x TransferDescriptor {%s, %i, %x} -> ", Link, nameof:(TD->Token), TD->MaximumLength, TD->PhysicalBufferPointer)

                this->DumpLink(Indent, TD->Link)
            }
        }
        define void DumpLink(i32 Link) {
            this->DumpLink(0, Link)
        }

        define void DumpLinkGraphVizInternal(i32 Link) {
            if (Link & LinkFlags::Terminator) {
                ; Terminator
            }
            else if (Link & LinkFlags::IsQueueHead) {
                ; Queue Head

                i32 DepthFirst := Link & LinkFlags::DepthFirst

                QueueHead* Queue := this->PhysicalToVirtual(Link & 0x7FFF_FFF0)
                Info("\"%x\" [shape=box,label=\"QH %s\"];\n", Link & 0x7FFF_FFF0, Queue->Name)

                if (DepthFirst) {
                    if (Queue->VerticalLink & LinkFlags::Terminator = 0) {
                        Info("\"%x\" -> \"%x\" [label=\"Vertical (FIRST)\"];\n", Link & 0x7FFF_FFF0, Queue->VerticalLink & 0x7FFF_FFF0)
                        this->DumpLinkGraphVizInternal(Queue->VerticalLink)
                    }

                    if (Queue->HorizontalLink & LinkFlags::Terminator = 0) {
                        Info("\"%x\" -> \"%x\" [label=\"Horizontal (NEXT)\"];\n", Link & 0x7FFF_FFF0, Queue->HorizontalLink & 0x7FFF_FFF0)
                        this->DumpLinkGraphVizInternal(Queue->HorizontalLink)
                    }
                }
                else {
                    if (Queue->HorizontalLink & LinkFlags::Terminator = 0) {
                        Info("\"%x\" -> \"%x\" [label=\"Horizontal (FIRST)\"];\n", Link & 0x7FFF_FFF0, Queue->HorizontalLink & 0x7FFF_FFF0)
                        this->DumpLinkGraphVizInternal(Queue->HorizontalLink)
                    }

                    if (Queue->VerticalLink & LinkFlags::Terminator = 0) {
                        Info("\"%x\" -> \"%x\" [label=\"Vertical (NEXT)\"];\n", Link & 0x7FFF_FFF0, Queue->VerticalLink & 0x7FFF_FFF0)
                        this->DumpLinkGraphVizInternal(Queue->VerticalLink)
                    }
                }
            }
            else {
                ; TD
                TransferDescriptor* TD := this->PhysicalToVirtual(Link & 0x7FFF_FFF0)

                i32 Length := TD->MaximumLength + 1

                if (Length = 0x800) {
                    Length := 0
                }

                Info("\"%x\" [shape=ellipse,label=\"TD %s, Len %i, DT %i\"];\n", Link & 0x7FFF_FFF0, nameof:(TD->Token), Length, TD->DataToggle)

                if (TD->Link & LinkFlags::Terminator = 0) {
                    Info("\"%x\" -> \"%x\";\n", Link & 0x7FFF_FFF0, TD->Link & 0x7FFF_FFF0)
                    this->DumpLinkGraphVizInternal(TD->Link)
                }
            }
        }

        define void DumpLinkGraphViz(i32 Link) {
            Info("digraph G {\n")

            this->DumpLinkGraphVizInternal(Link)

            Info("}\n")
        }

        define i32 GetCurrentFrameNumber() {
            return (this->Read16(Registers::FrameNumber) As i32) & 0x3FF
        }

        i8 Stopped

        i64 RetiredHighWatermark
        i64 ScheduledHighWatermark

        define i32 ScheduleSinglePeriodicTransfer(i32** ppTailLink, PeriodicTransferHandle* Handle, i64 GlobalFrameNumber) {
            if (GlobalFrameNumber % Handle->Period = Handle->Phase) {
                Info("%i mod %i = %i, ", GlobalFrameNumber, Handle->Period, GlobalFrameNumber % Handle->Period)

                ; This transfer should be scheduled in this frame

                TransferDescriptor* TD := Handle->ScheduleOutgoingTransferDescriptor()

                i32 FrameNumber := (GlobalFrameNumber % 1024) As i32

                Info(" sched %x in slot %i\n", this->PackLink(TD, 0), FrameNumber)
                
                TD->ScheduledGlobalFrameNumber := GlobalFrameNumber

                i32* pTailLink := *ppTailLink

                pTailLink[0] := this->PackLink(TD, 0)
                ppTailLink[0] := TD~>Link

                return Handle->SingleTransferBandwidth
            }

            return 0
        }

        define void ScheduleSingleFrame(i64 GlobalFrameNumber) {
            if (GlobalFrameNumber < this->ScheduledHighWatermark) {
                return
            }

            i32 BandwidthScheduled := 0

            ; Schedule all periodic transfers for this frame

            i32 FrameNumber := (GlobalFrameNumber % 1024) As i32
            i32* pTailLink := &this->FrameList[FrameNumber]


            i32 IsochronousCount := this->IsochronousTransfers->Count()

            for (i32 Index := 0, Index < IsochronousCount, Index++) {
                PeriodicTransferHandle* Handle := this->IsochronousTransfers->At(Index)

                BandwidthScheduled += this->ScheduleSinglePeriodicTransfer(&pTailLink, Handle, GlobalFrameNumber)
            }

            i32 InterruptCount := this->InterruptTransfers->Count()

            for (i32 Index := 0, Index < InterruptCount, Index++) {
                PeriodicTransferHandle* Handle := this->InterruptTransfers->At(Index)

                BandwidthScheduled += this->ScheduleSinglePeriodicTransfer(&pTailLink, Handle, GlobalFrameNumber)
            }

            if (BandwidthScheduled > 900) {
                Info("Warning: UHCI periodic bandwidth overcommit! Scheduled %i bytes for frame %i\n", BandwidthScheduled, FrameNumber)
            }

            *pTailLink := this->PackLink(this->ControlTransferQueue, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)

            ;pTailLink[0] := this->PackLink(this->ControlQueueHead, 0)
        }


        define void ScheduleNextQuarter(i64 GlobalFrameNumber) {
            ;Info("Scheduling quarter %i - %i\n", GlobalFrameNumber, GlobalFrameNumber + 256)

            i64 Target := GlobalFrameNumber + 256
            i64 Gap := Target - this->ScheduledHighWatermark

            if (GlobalFrameNumber > this->ScheduledHighWatermark) {
                Panic("UHCI: Did not schedule next quarter in time!")
            }

            ;Info("High Watermark %i, Gap %i\n", this->ScheduledHighWatermark, Gap)

            for (i64 Index := 0, Index < Gap, Index++) {
                this->ScheduleSingleFrame(this->ScheduledHighWatermark + Index)
            }

            this->ScheduledHighWatermark := Target
        }

        declare void Stop()

        define void RetireSinglePeriodicTransfer(PeriodicTransferHandle* Handle, i64 GlobalFrameNumber) {

            i32 Count := Handle->ScheduledTransferDescriptors->Count()

            for (i32 Index := Count - 1, Index >= 0, Index--) {
                TransferDescriptor* TD := Handle->ScheduledTransferDescriptors->At(Index)

                if (TD->ScheduledGlobalFrameNumber < GlobalFrameNumber) {
                    ; This TD was scheduled in the past, retire it

                    if (TD->Active) {
                        ;Info("UHCI: Retiring active periodic TD\n")
                    }

                    Info("RET TD %x (buf: %x) @ %i, GFN %i\n", this->PackLink(TD, 0), TD->Buffer, GlobalFrameNumber, TD->ScheduledGlobalFrameNumber)

                    ;Info("RET %i @ %i\n", TD->ScheduledGlobalFrameNumber, GlobalFrameNumber)

                    Handle->RetireTransferDescriptor(TD)
                }
                else if (TD->ScheduledGlobalFrameNumber = GlobalFrameNumber) {
                    ; We have no way to know how much of this frame is complete.
                    ; We'll try again next time
                }
                else if (TD->ScheduledGlobalFrameNumber - 1 = GlobalFrameNumber) {
                    ; Apparently this is a problem too
                }
                else if (TD->ScheduledGlobalFrameNumber > GlobalFrameNumber) {
                    if (TD->ActualLength) {
                        this->Stop()

                        Info("TD %x completed in the future! GFN %i, Current GFN %i\n", this->VirtualToPhysical(TD), TD->ScheduledGlobalFrameNumber, GlobalFrameNumber)
                        i32 FrameNumber := this->GetCurrentFrameNumber()

                        Info("Current Hardware Frame Number: %i\n", FrameNumber)

                        Info("=== Frame list as of current GFN ===\n")
                        this->DumpLinkGraphViz(this->FrameList[(GlobalFrameNumber - 1 ) % 1024])
                        Info("=== Frame list as of TD's scheduled GFN ===\n")
                        this->DumpLinkGraphViz(this->FrameList[(TD->ScheduledGlobalFrameNumber % 1024) As i32])

                        for (i32 CheckIndex := 0, CheckIndex < 64, CheckIndex++) {
                            i32 CheckFrameNumber := ((GlobalFrameNumber - CheckIndex) % 1024) As i32

                            i32 CheckLink := this->FrameList[CheckFrameNumber]
                            i32 ControlQHLink := this->PackLink(this->ControlTransferQueue, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)

                            i8 Found := false

                            while (CheckLink != ControlQHLink) {
                                TransferDescriptor* CheckTD := this->PhysicalToVirtual(CheckLink & 0x7FFF_FFF0)

                                if (CheckTD = TD) {
                                    Info("Found TD in frame %i\n", CheckFrameNumber)
                                    Found := true
                                    break
                                }
                                else {
                                    if (CheckTD->Link & LinkFlags::Terminator) {
                                        Found := true
                                        break
                                    }

                                    CheckLink = CheckTD->Link
                                }
                            }

                            if (Found) {
                                break
                            }
                        }


                        Panic("TD Completed in the future!!!!")
                    }
                }
            }

            ;Handle->DumpStatus()
        }

        define void RetirePastFrames(i64 GlobalFrameNumber) {
            ; Called at least every 128 frames to retire any periodic transfers that were scheduled in the past but haven't been retired yet (e.g. because the interrupt thread was busy with something else when they were supposed to be retired)

            i64 Gap := GlobalFrameNumber - this->RetiredHighWatermark

            if (Gap >= 256) {
                Panic("UHCI: 256 frame retirement gap")
            }

            i32 IsochronousCount := this->IsochronousTransfers->Count()

            for (i32 Index := 0, Index < IsochronousCount, Index++) {
                PeriodicTransferHandle* Handle := this->IsochronousTransfers->At(Index)

                this->RetireSinglePeriodicTransfer(Handle, GlobalFrameNumber)
            }

            i32 InterruptCount := this->InterruptTransfers->Count()

            for (i32 Index := 0, Index < InterruptCount, Index++) {
                PeriodicTransferHandle* Handle := this->InterruptTransfers->At(Index)

                this->RetireSinglePeriodicTransfer(Handle, GlobalFrameNumber)
            }

            this->RetiredHighWatermark := GlobalFrameNumber
        }

        define void RetireQueueHeads(i64 GlobalFrameNumber) {
            i32 Count := this->QueueHeadsInFlight->Count()

            ;Info("**********\n")

            ;this->DumpLinkGraphViz(this->PackLink(this->ControlTransferQueue, LinkFlags::IsQueueHead))

            for (i32 Index := Count - 1, Index >= 0, Index--) {
                ; Iterate backwards since we might remove items from the list

                QueueHead* QH := this->QueueHeadsInFlight->At(Index)

                if (QH->VerticalLink & 1) {
                    Info("Retiring Queue Head %s (%x)\n", QH->Name, this->VirtualToPhysical(QH))

                    ; This QH has been processed by the HC, retire it

                    QH->Handle->Complete()

                    this->QueueHeadsInFlight->Remove(Index)
                }
            }

            QueueHead* Current := this->ControlTransferQueue

            while (Current->HorizontalLink & LinkFlags::Terminator = 0) {
                QueueHead* Next := this->PhysicalToVirtual(Current->HorizontalLink & 0x7FFF_FFF0)

                if (Next = this->BulkTransferQueue) {
                    break
                }

                if (Next->VerticalLink & LinkFlags::Terminator) {
                    Current->HorizontalLink := Next->HorizontalLink
                }
            }

            QueueHead* Current := this->BulkTransferQueue

            while (Current->HorizontalLink & LinkFlags::Terminator = 0) {
                i32 Link := Current->HorizontalLink

                if (Link & LinkFlags::Terminator) {
                    break
                }

                QueueHead* Next := this->PhysicalToVirtual(Link & 0x7FFF_FFF0)

                if (Next->VerticalLink & LinkFlags::Terminator) {
                    Current->HorizontalLink := Next->HorizontalLink
                }
            }

            this->DumpLinkGraphViz(this->PackLink(this->ControlTransferQueue, LinkFlags::IsQueueHead))
        }

        i32 CycleCounter
        i32 LastFrameNumber

        define void InterruptThread() {
            Print("UHCI Interrupt Thread started\n")

            loop {
                i8 IsRealInterrupt := this->Interrupt->Wait(128)

                ;Info("UHCI Interrupt Thread woke up\n")

                i32 CurrentFrameNumber := this->GetCurrentFrameNumber()

                if (CurrentFrameNumber < this->LastFrameNumber) {
                    this->CycleCounter++
                    ;Print("New UHCI cycle: %i\n", this->CycleCounter)
                }

                this->LastFrameNumber := CurrentFrameNumber

                i64 GlobalFrameNumber := (this->CycleCounter * 1024) + CurrentFrameNumber


                this->RetirePastFrames(GlobalFrameNumber)
                this->ScheduleNextQuarter(GlobalFrameNumber)

                ;Info("Scheduled out to %i\n", this->ScheduledHighWatermark)

                this->RetireQueueHeads(GlobalFrameNumber)
            }
        }

        define void Stop() {
            this->Stopped := true

            RegisterFields::Command CommandFields := 0 As RegisterFields::Command
            this->Write16(Registers::Command, CommandFields As i16)

            Print("UHCI Controller stopped\n")
        }

        define void OnInterrupt() {
            ;Print("UHCI Interrupt!\n")

            ; Clear status bit to allow interrupt line to de-assert

            RegisterFields::Status StatusFields := this->Read16(Registers::Status) As RegisterFields::Status

            if (StatusFields.InterruptWasFromError) {
                Print("UHCI Error!\n")
                this->Stop()

                i32 FrameNumber := this->GetCurrentFrameNumber()
                i64 GlobalFrameNumber := (this->CycleCounter * 1024) + FrameNumber

                Info("UHCI Controller Error at frame %i (global frame %i)\n", FrameNumber, GlobalFrameNumber)

                this->DumpLinkGraphViz(this->FrameList[FrameNumber])

                i32 ErrorLink := this->FrameList[FrameNumber]
                i32 Current := ErrorLink
                TransferDescriptor* TD := null

                Info("FrameList[%i] = %x\n", FrameNumber, ErrorLink)

                loop {
                    i32 Next := LinkFlags::Terminator As i32

                    if (Current & LinkFlags::IsQueueHead) {
                        QueueHead* QH := this->PhysicalToVirtual(Current & 0x7FFF_FFF0)

                        Info(" -> QH, HL: %x, VL: %x, DF? %i\n", QH->HorizontalLink, QH->VerticalLink, Current & LinkFlags::IsQueueHead)

                        Next := QH->HorizontalLink
                        i32 OppositeLink := QH->VerticalLink

                        if (ErrorLink & LinkFlags::DepthFirst) {
                            Next := QH->VerticalLink
                            OppositeLink := QH->HorizontalLink
                        }

                        if (Next & LinkFlags::Terminator) {
                            Next := OppositeLink
                        }
                    }
                    else {
                        TD := this->PhysicalToVirtual(Current & 0x7FFF_FFF0)
                        
                        Info("-> TD, done\n")

                        break
                    }

                    if (Next & LinkFlags::Terminator) {
                        break
                    }

                    Current := Next
                }

                i32 Size := TD->MaximumLength + 1

                if (Size = 0x800) {
                    Size := 0
                }

                Info("Error on TD %x, Token %s, Size %i, DT %i\n", this->VirtualToPhysical(TD), nameof:(TD->Token), Size, TD->DataToggle)

                Info("{\n")
                Info("\tActualLength: %i\n", TD->ActualLength)
                Info("\tBitstuffError? %i\n", TD->BitstuffError)
                Info("\tTimeoutOrCRCError? %i\n", TD->TimeoutOrCRCError)
                Info("\tBabbleDetected? %i\n", TD->BabbleDetected)
                Info("\tDataBufferError? %i\n", TD->DataBufferError)
                Info("\tStalled? %i\n", TD->Stalled)
            }
            else if (StatusFields.HostSystemError) {
                Print("UHCI Host System Error!\n")
                this->Stop()
            }
            else if (StatusFields.HostControllerError) {
                Print("UHCI Host Controller Error!\n")
                this->Stop()
            }

            if (StatusFields.InterruptWasFromTransfer) {
                this->Interrupt->Signal()

                ; Writing 1s clears, so rewriting the current value clears the register
                this->Write16(Registers::Status, StatusFields As i16)
            }

            LocalAPIC->EOI()
        }

        static void OnInterrupt(AMD64Context* Context, i32 InterruptNumber) {
            (FirstUHCIController As Controller*)->OnInterrupt()
        }

        define QueueHead* AllocateQueueHead(i8* Name) {
            QueueHead* Out := this->Heap->Allocate(#QueueHead)

            Out->HorizontalLink := this->PackLink(null, LinkFlags::Terminator)
            Out->VerticalLink := this->PackLink(null, LinkFlags::Terminator)
            Out->Name := Name

            return Out
        }

        define TransferDescriptor* AllocateTransferDescriptor(i32 Address, i32 Endpoint, TransferSpeed Speed, TransferToken Token, i32 Length, void* Buffer) {
            TransferDescriptor* Out := this->Heap->Allocate(#TransferDescriptor)

            Out->Link := this->PackLink(null, LinkFlags::Terminator)

            Out->InterruptAfterErrorCount := 3
            Out->Active := true

            Out->DeviceAddress := Address As i8
            Out->Endpoint := Endpoint As i8

            if (Speed = TransferSpeed::Low) {
                Out->IsLowSpeedDevice := true
            }
            else {
                Out->IsLowSpeedDevice := false
            }

            if (Length = 0) {
                Length := 0x800
            }

            Out->MaximumLength := (Length - 1) As i16
            
            Out->ShouldInterruptOnComplete := true
            Out->Token := Token
            ;Out->ActualLength := Length As i16

            if (Buffer) {
                Out->Buffer := Buffer
                Out->PhysicalBufferPointer := this->VirtualToPhysical(Buffer)
            }

            return Out
        }

        define void* Allocate(i32 Size) {
            return this->Heap->Allocate(Size)
        }

        define QueueHead* FindQueueTail(QueueHead* Head, i32 AlternativeTerminator) {
            QueueHead* Current := Head

            loop {
                i32 Horizontal := Current->HorizontalLink

                if (Horizontal & LinkFlags::Terminator != 0 || Horizontal = AlternativeTerminator) {
                    return Current
                }

                Current := this->PhysicalToVirtual(Horizontal & 0x7FFF_FFF0)
            }

            return null
        }

        define void ScheduleControlTransfer(TransferHandle* Handle) {
            i32 BulkTransferLink := this->PackLink(this->BulkTransferQueue, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)

            QueueHead* Tail := this->FindQueueTail(this->ControlTransferQueue, BulkTransferLink)

            Handle->QH->HorizontalLink := BulkTransferLink

            Tail->HorizontalLink := this->PackLink(Handle->QH, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)
        }

        define void ScheduleBulkTransfer(TransferHandle* Handle) {
            QueueHead* Tail := this->FindQueueTail(this->BulkTransferQueue, 0)

            Handle->QH->HorizontalLink := this->PackLink(null, LinkFlags::Terminator)

            Tail->HorizontalLink := this->PackLink(Handle->QH, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)
        }

        i32 BulkTransferCount

        define ITransferHandle* SendBulkTransfer(i32 Address, i32 Endpoint, i8* pDataToggle, TransferSpeed Speed, RequestDataPhaseDirection DataDirection, void* Buffer, i32 DataLength) {
            i8* Name := FormatString("Bulk Transfer %i", this->BulkTransferCount++)

            QueueHead* QH := this->AllocateQueueHead(Name)

            void* RelocatedBuffer := this->Heap->Allocate(DataLength)

            if (DataDirection = USB::RequestDataPhaseDirection::HostToDevice) {
                MoveMemory(RelocatedBuffer, Buffer, DataLength)
            }

            TransferHandle* Handle := new TransferHandle(this, DataDirection, QH, Buffer, RelocatedBuffer, DataLength)

            TransferToken Token := TransferToken::OUT

            if (DataDirection = USB::RequestDataPhaseDirection::DeviceToHost) {
                Token := TransferToken::IN
            }

            i32 MaxSize := 8

            if (Speed = TransferSpeed::Full) {
                MaxSize := 64
            }

            TransferDescriptor* Previous := null
            void* PacketData := RelocatedBuffer

            while (DataLength > 0) {
                i32 PacketSize := MaxSize

                if (DataLength < MaxSize) {
                    PacketSize := DataLength
                }

                TransferDescriptor* TD := this->AllocateTransferDescriptor(Address, Endpoint, Speed, Token, PacketSize, PacketData)

                TD->DataToggle := *pDataToggle
                pDataToggle[0] := !pDataToggle[0]

                Handle->AddTransferDescriptor(TD)

                PacketData += PacketSize
                DataLength -= PacketSize
            }

            i32 Count := Handle->TDs->Count()

            for (i32 Index := 0, Index < Count - 1, Index++) {
                TransferDescriptor* Previous := Handle->TDs->At(Index)
                TransferDescriptor* Next := Handle->TDs->At(Index + 1)

                Previous->Link := this->PackLink(Next, LinkFlags::DepthFirst)
            }

            QH->VerticalLink := this->PackLink(Handle->TDs->At(0), LinkFlags::DepthFirst)

            this->QueueHeadsInFlight->Push(QH)

            ;SleepMS(1)

            ;Info("=========== Scheduling %s ==========\n", QH->Name)



            ;this->DumpLinkGraphViz(this->PackLink(this->ControlTransferQueue, LinkFlags::IsQueueHead))

            ;this->DumpLink(this->PackLink(QH, LinkFlags::IsQueueHead))
            ;this->DumpLink(this->PackLink(this->PeriodicQueueHeads[QueueHeadPeriod::_1_MS], LinkFlags::IsQueueHead))

            ;this->DumpLinkGraphViz(this->PackLink(QH, LinkFlags::IsQueueHead))

            ;this->DumpLink(this->PackLink(QH, LinkFlags::IsQueueHead))
            ;this->DumpLink(this->PackLink(this->PeriodicQueueHeads[QueueHeadPeriod::_1_MS], LinkFlags::IsQueueHead))

            this->ScheduleBulkTransfer(Handle)

            return Handle
        }

        i32 ControlTransferCount

        define ITransferHandle* SendControlTransfer(i32 Address, i32 Endpoint, TransferSpeed Speed, SetupPacket* Setup, void* Buffer, i32 DataLength) {
            ;Info("SendControlTransfer to %i:%i, Speed %s, DataDirection %s, DataLength %i\n", Address, Endpoint, nameof:(Speed), nameof:(Setup->DataDirection), DataLength)
            ;Info("%hexdump\n", Buffer, DataLength)

            QueueHead* QH := this->AllocateQueueHead(FormatString("Control Transfer %i", this->ControlTransferCount++))

            SetupPacket* RelocatedSetupPacket := this->Heap->Allocate(#SetupPacket)
            MoveMemory(RelocatedSetupPacket, Setup, #SetupPacket)

            void* RelocatedBuffer := this->Heap->Allocate(DataLength)

            if (Setup->DataDirection = USB::RequestDataPhaseDirection::HostToDevice) {
                MoveMemory(RelocatedBuffer, Buffer, DataLength)
            }
            
            TransferHandle* Handle := new TransferHandle(this, RelocatedSetupPacket, QH, Buffer, RelocatedBuffer)

            TransferDescriptor* SetupTD := this->AllocateTransferDescriptor(Address, Endpoint, Speed, TransferToken::SETUP, 8, RelocatedSetupPacket)
            Handle->AddTransferDescriptor(SetupTD)

            TransferToken Token := TransferToken::OUT
            TransferToken StatusToken := TransferToken::IN

            if (Setup->DataDirection = USB::RequestDataPhaseDirection::DeviceToHost) {
                Token := TransferToken::IN
                StatusToken := TransferToken::OUT
            }

            i32 MaxSize := 8

            if (Speed = TransferSpeed::Full) {
                MaxSize := 64
            }

            TransferDescriptor* Previous := SetupTD
            void* PacketData := RelocatedBuffer

            i8 DataToggle := 1

            while (DataLength > 0) {
                i32 PacketSize := MaxSize

                if (DataLength < MaxSize) {
                    PacketSize := DataLength
                }

                TransferDescriptor* TD := this->AllocateTransferDescriptor(Address, Endpoint, Speed, Token, PacketSize, PacketData)
                TD->DataToggle := DataToggle

                Handle->TDs->Push(TD)

                PacketData += PacketSize
                DataLength -= PacketSize
                DataToggle := !DataToggle
            }

            TransferDescriptor* StatusTD := this->AllocateTransferDescriptor(Address, Endpoint, Speed, StatusToken, 0, null)

            StatusTD->DataToggle := true

            Handle->AddTransferDescriptor(StatusTD)

            i32 Count := Handle->TDs->Count()

            for (i32 Index := 0, Index < Count - 1, Index++) {
                TransferDescriptor* Previous := Handle->TDs->At(Index)
                TransferDescriptor* Next := Handle->TDs->At(Index + 1)

                Previous->Link := this->PackLink(Next, LinkFlags::DepthFirst)
            }

            QH->VerticalLink := this->PackLink(SetupTD, LinkFlags::DepthFirst)

            this->QueueHeadsInFlight->Push(QH)

            ;Info("=========== Scheduling %s ==========\n", QH->Name)
            ;this->DumpLinkGraphViz(this->PackLink(QH, LinkFlags::IsQueueHead))

            this->ScheduleControlTransfer(Handle)

            return Handle
        }

        define IPeriodicTransferHandle* ScheduleInterruptTransfer(i32 Address, i32 Endpoint, TransferSpeed Speed, RequestDataPhaseDirection Direction, i32 Size, i32 Period) {
            ;Print("Scheduling interrupt transfer to %i:%i, Speed %s, Direction %s, Size %i, Period %i\n", Address, Endpoint, nameof:(Speed), nameof:(Direction), Size, Period)

            TransferToken Token := TransferToken::OUT

            if (Direction = USB::RequestDataPhaseDirection::DeviceToHost) {
                Token := TransferToken::IN
            }

            PeriodicTransferHandle* Handle := new PeriodicTransferHandle(this)

            Handle->DescribeTransfer(Speed, PeriodicTransferType::Interrupt, Token, Size, Address, Endpoint)
            Handle->DescribeTiming(Period, 0)

            ; Give drivers 128ms worth of headroom before running out
            ;  of buffers

            i32 TransfersPerQuarter := ((256 + 128) / Period) + 1

            for (i32 Index := 0, Index < TransfersPerQuarter, Index++) {
                TransferDescriptor* TD := this->AllocateTransferDescriptor(Address, Endpoint, Speed, Token, Size, this->Allocate(Size))

                Handle->ProvideTransferDescriptor(TD)
            }
            
            this->InterruptTransfers->Push(Handle)

            return Handle
        }

        define void Free(ITransferHandle* Handle) {
            TransferHandle* Transfer := Handle As TransferHandle*

            this->Heap->Free(Transfer->Setup)

            i32 Count := Transfer->TDs->Count()

            for (i32 Index := 0, Index < Count, Index++) {
                TransferDescriptor* TD := Transfer->TDs->At(Index)
                this->Heap->Free(TD)
            }

            this->Heap->Free(Transfer->QH)
            ;this->Heap->Free(Transfer->RelocatedDataBuffer)
        }

        RegisterFields::Port[2] Ports

        define void CheckPort(Registers Port) {
            if (this->Stopped) {
                return
            }

            RegisterFields::Port PortFields := this->Read16(Port) As RegisterFields::Port

            if (Port = Registers::Port1) {
                if (PortFields = this->Ports[0]) {
                    return
                }
                else {
                    this->Ports[0] := PortFields
                }
            }
            else if (Port = Registers::Port2) {
                if (PortFields = this->Ports[1]) {
                    return
                }
                else {
                    this->Ports[1] := PortFields
                }
            }

            Info("Port %x: %b (Present? %i)\n", Port, PortFields, PortFields.Present)

            if (PortFields.DevicePresent) {
                ;Print("Device present on port %d\n", Port)

                if (PortFields.ConnectStatusChange) {
                    Print("Connect status change on port %d\n", Port)

                    PortFields.ConnectStatusChange := false
                    this->Write16(Port, PortFields As i16)

                    PortFields := this->Read16(Port) As RegisterFields::Port
                    PortFields.Reset := true
                    this->Write16(Port, PortFields As i16)

                    SleepMS(100)
                    PortFields := this->Read16(Port) As RegisterFields::Port
                    PortFields.Reset := false
                    this->Write16(Port, PortFields As i16)

                    SleepMS(50)
                    PortFields := this->Read16(Port) As RegisterFields::Port
                    PortFields.Enable := true
                    this->Write16(Port, PortFields As i16)

                    loop {
                        PortFields := this->Read16(Port) As RegisterFields::Port

                        if (PortFields.Enable) {
                            Print("Port %x enabled\n", Port)
                            Info("Port %x enabled\n", Port)
                            break
                        }

                        SleepMS(100)
                    }

                    ;this->FrameList[200] := this->RemoveLinkFlag(this->FrameList[200], LinkFlags::Terminator)

                    this->Bus->NotifyAttach()

                    ;USB::Device* Dev := new USB::Device(this, Address)
                    ;USB::DeviceDescriptor* _Device := Dev->Descriptor

                    /* SleepMS(10)

                    this->Stop := true
                    RegisterFields::Command CommandFields := 0 As RegisterFields::Command
                    this->Write16(Registers::Command, CommandFields As i16) */

                    

                    ;Device* Dev := new Device(this, _Device)

                    ;SleepMS(10)

                    ;this->Stop()
                    
                }

                if (PortFields.EnableChange) {
                    Print("Enable change on port %d\n", Port)
                }
            } else {
                ;Print("No device present on port %d\n", Port)
            }
        }

        define void CheckPortsThread() {
            loop {
                this->CheckPort(Registers::Port1)
                this->CheckPort(Registers::Port2)

                SleepMS(1000)
            }
        }

        define void Setup() {
            i32 Pin := this->Device->InterruptPin - 1
            i32 PinToIOAPIC := ACPI_GetInterruptNumber(this->Address->Segment, this->Address->Bus, this->Address->Device, this->Address->Function, Pin)

            RegisterInterruptHandler(0x35, &self:OnInterrupt)

            FirstIOAPIC->ForwardInterrupt(PinToIOAPIC, LocalAPIC->ID, 0x35)
            FirstIOAPIC->Mask(PinToIOAPIC, false)

            Print("Pin %i, IOAPIC %i\n", Pin, PinToIOAPIC)

            ;Print("CanUseMsi? %i", this->Device->CanUseMSI())
            ;Halt()

            this->IOBase := this->Device->ReadBAR(4) & 0b1111_1111_1110_0000

            Info("UCHI IOBase %x, Version %x\n", this->IOBase, this->USBVersion)

            this->FrameList := KernelPageAllocator->AllocateVirtual(1)
            this->PhysicalFrameList := KernelAddressSpace->VirtualToPhysical(this->FrameList)

            i32 PoolPageCount := PAGES_IN_2MB / 8 ; 512k pool

            this->HeapPoolVirtual := Trampoline~>PageTree->FindGap(PoolPageCount, 0x4000_0000_0000, PoolPageCount)
            this->HeapPoolPhysical := PhysicalMemory->Allocate(PoolPageCount)

            Trampoline~>PageTree->SetRange(this->HeapPoolVirtual, this->HeapPoolPhysical, PoolPageCount, PAGE_PRESENT | PAGE_WRITE)

            this->Heap := KernelHeapAllocate('UHCIHeap', #PalHeap)
            this->Heap->Initialize(this->HeapPoolVirtual, PoolPageCount * PAGE_SIZE)
            this->Heap->Bootstrap()

            Print("UHCI Heap @ %x, Physical %x\n", this->HeapPoolVirtual, this->HeapPoolPhysical)

            ; Set up control transfer queue
            this->ControlTransferQueue := this->AllocateQueueHead("Control Queue")
            this->BulkTransferQueue := this->AllocateQueueHead("Bulk Queue")

            this->ControlTransferQueue->HorizontalLink := this->PackLink(this->BulkTransferQueue, LinkFlags::IsQueueHead | LinkFlags::DepthFirst)

            ; Populate frame list
            this->ScheduleNextQuarter(0)

            this->DumpLinkGraphViz(this->FrameList[0])

            this->Device->Write16(0xC0, 0x2000)
            this->Device->Command |= PCI_COMMAND_REGISTER_BUS_MASTER As i16

            RegisterFields::Command CommandFields := 0 As RegisterFields::Command
            CommandFields.GlobalReset := true
            CommandFields.HostControllerReset := true
            this->Write16(Registers::Command, CommandFields As i16)

            SleepMS(20)

            CommandFields := this->Read16(Registers::Command) As RegisterFields::Command

            if (CommandFields.HostControllerReset) {
                Print("Host controller reset failed\n")
                return
            }

            CommandFields.GlobalReset := false
            this->Write16(Registers::Command, CommandFields As i16)

            this->Write32(Registers::FrameListBase, this->PhysicalFrameList As i32)
            this->Write16(Registers::FrameNumber, 0)

            RegisterFields::Interrupt InterruptFields := 0 As RegisterFields::Interrupt
            InterruptFields.InterruptOnComplete := true
            this->Write16(Registers::InterruptEnable, InterruptFields As i16)

            this->ScheduleNextQuarter(0)

            CommandFields.RunStop := true
            CommandFields.Enable64BitPackets := true
            this->Write16(Registers::Command, CommandFields As i16)

            Task* CheckPorts := Scheduler->AddLightTask(null, "UHCI Port Checker")
            CheckPorts~>Context->CallMethod(this, &self.CheckPortsThread)
            CheckPorts->Unblock()

            Task* InterruptThread := Scheduler->AddLightTask(null, "UHCI Interrupt Handler")
            InterruptThread~>Context->CallMethod(this, &self.InterruptThread)
            InterruptThread->Unblock()
        }
    }
}