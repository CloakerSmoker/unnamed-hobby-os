
interface IFileBlockHandle {
    virtual i32 GetFileBlockSize()

    virtual i8 ReadFileBlock(i32 BlockNumber, void* Buffer)
    virtual i8 ReadFileBlocks(i32 StartingBlockNumber, i32 BlockCount, void* Buffer) {
        for (i32 Index := 0, Index < BlockCount, Index++) {
            if !(this->ReadFileBlock(StartingBlockNumber + Index, Buffer + Index * this->GetFileBlockSize())) {
                return false
            }
        }

        return true
    }

    virtual i8 WriteFileBlock(i32 BlockNumber, void* Buffer)
    virtual i8 WriteFileBlocks(i32 StartingBlockNumber, i32 BlockCount, void* Buffer) {
        for (i32 Index := 0, Index < BlockCount, Index++) {
            if !(this->WriteFileBlock(StartingBlockNumber + Index, Buffer + Index * this->GetFileBlockSize())) {
                return false
            }
        }

        return true
    }
}

class BlockAlignedIO derives INew {
    IFileBlockHandle* FileHandle

    define void New(IFileBlockHandle* FileHandle) {
        this->FileHandle := FileHandle
    }

    define i32 Read(i32* pOffset, i32 FileSize, void* Buffer, i32 Size, void* ScratchBlock) {
        if (Size <= 0 || *pOffset >= FileSize) {
            return 0
        }

        i32 BlockSize := this->FileHandle->GetFileBlockSize()
        i32 StartOffset := *pOffset

        if (StartOffset + Size > FileSize) {
            Size := FileSize - StartOffset
        }

        i32 Remaining := Size
        i32 Offset := StartOffset

        i32 FirstBlock := Offset / BlockSize
        i32 FirstBlockOffset := Offset % BlockSize

        if (FirstBlockOffset) {
            if !(this->FileHandle->ReadFileBlock(FirstBlock, ScratchBlock)) {
                FastSetMemory8(ScratchBlock, BlockSize, 0)
            }

            i32 PrefixSize := BlockSize - FirstBlockOffset

            if (PrefixSize > Remaining) {
                PrefixSize := Remaining
            }

            MoveMemory(Buffer, ScratchBlock + FirstBlockOffset, PrefixSize)

            Buffer += PrefixSize
            Remaining -= PrefixSize
            FirstBlock += 1
        }

        i32 FullBlockCount := Remaining / BlockSize

        this->FileHandle->ReadFileBlocks(FirstBlock, FullBlockCount, Buffer)
/* 
        for (i32 Index := 0, Index < FullBlockCount, Index += 1) {
            if !(this->FileHandle->ReadFileBlock(FirstBlock + Index, Buffer)) {
                FastSetMemory8(Buffer, BlockSize, 0)
            }

            Buffer += BlockSize
        } */

        i32 Middle := FullBlockCount * BlockSize

        Remaining -= Middle
        Buffer += Middle

        if (Remaining) {
            if !(this->FileHandle->ReadFileBlock(FirstBlock + FullBlockCount, ScratchBlock)) {
                FastSetMemory8(ScratchBlock, BlockSize, 0)
            }

            MoveMemory(Buffer, ScratchBlock, Remaining)
        }

        *pOffset := StartOffset + Size

        return Size
    }

    define i32 Write(i32* pOffset, i32* pFileSize, void* Data, i32 Size, void* ScratchBlock) {
        if (Size <= 0) {
            return 0
        }

        i32 BlockSize := this->FileHandle->GetFileBlockSize()
        i32 StartOffset := *pOffset
        i32 OriginalFileSize := *pFileSize

        i32 Remaining := Size
        i32 Offset := StartOffset

        i32 FirstBlock := Offset / BlockSize
        i32 FirstBlockOffset := Offset % BlockSize

        if (FirstBlockOffset) {
            i32 PrefixSize := BlockSize - FirstBlockOffset

            if (PrefixSize > Remaining) {
                PrefixSize := Remaining
            }

            i32 BlockStartOffset := FirstBlock * BlockSize

            if (BlockStartOffset < OriginalFileSize) {
                if !(this->FileHandle->ReadFileBlock(FirstBlock, ScratchBlock)) {
                    FastSetMemory8(ScratchBlock, BlockSize, 0)
                }
            }
            else {
                FastSetMemory8(ScratchBlock, BlockSize, 0)
            }

            MoveMemory(ScratchBlock + FirstBlockOffset, Data, PrefixSize)
            this->FileHandle->WriteFileBlock(FirstBlock, ScratchBlock)

            Data += PrefixSize
            Remaining -= PrefixSize
            FirstBlock += 1
        }

        i32 FullBlockCount := Remaining / BlockSize

        for (i32 Index := 0, Index < FullBlockCount, Index += 1) {
            this->FileHandle->WriteFileBlock(FirstBlock + Index, Data)

            Data += BlockSize
        }

        Remaining -= FullBlockCount * BlockSize

        if (Remaining) {
            i32 LastBlock := FirstBlock + FullBlockCount
            i32 LastBlockStart := LastBlock * BlockSize

            if (LastBlockStart < OriginalFileSize) {
                if !(this->FileHandle->ReadFileBlock(LastBlock, ScratchBlock)) {
                    FastSetMemory8(ScratchBlock, BlockSize, 0)
                }
            }
            else {
                FastSetMemory8(ScratchBlock, BlockSize, 0)
            }

            MoveMemory(ScratchBlock, Data, Remaining)
            this->FileHandle->WriteFileBlock(LastBlock, ScratchBlock)
        }

        *pOffset := StartOffset + Size

        if (*pOffset > *pFileSize) {
            *pFileSize := *pOffset
        }

        return Size
    }
}