
define void SplitLowHigh(i64 Value, i32* Low, i32* High) {
    Low[0] := (Value & 0xFFFF_FFFF) As i32
    High[0] := ((Value >> 32) & 0xFFFF_FFFF) As i32
}

define void SplitLowHigh(void* RawValue, i32* Low, i32* High) {
    SplitLowHigh(VirtualToPhysical(RawValue), Low, High)
}

namespace ATA {
    enum Command As i8 {
        DEVICE_RESET := 0x08,
        READ_DMA_EXT := 0x25,
        WRITE_DMA_EXT := 0x35,
        IDENTIFY_DEVICE := 0xEC,
        IDENTIFY_DEVICE_DMA := 0xEE
    }
}

namespace SATA {
    enum DeviceType {
        None
        SATA
        SATAPI
        EnclosureBridge
        PortMultiplier
    }

    enum TransferDirection {
        DeviceToHost
        HostToDevice
        None
    }

    struct Request {
        TransferDirection Direction

        ATA::Command Command

        i64 DeviceLocation
        i32 BlockCount

        union {
            void* OutgoingBuffer
            void* IncomingBuffer
            void* DataBuffer
        }

        union {
            i32 OutgoingSize
            i32 IncomingSize
            i32 DataSize
        }
    }

    interface IRequestHandle {
        virtual IRequestHandle* Wait() ; needs to return `this` for chaining
        virtual i8 Poll(i32)
        virtual void Free()
    }

    interface IController {
        virtual i32 GetPortCount()
        virtual DeviceType GetPortDeviceType(i32 Port)
        virtual IRequestHandle* SendRequest(i32, Request*)
    }

    enum DeviceState {
        Identifying
        Ready
    }

    class Device implements IBlockDevice, derives INew {
        IController* Controller
        i32 Port

        IRequestHandle* CurrentRequest
        DeviceState State

        union {
            i8[512] IdentifyBuffer
            ATAIdentificationSpace IdentifyData
        }

        i8[41] Model
        i8[41] SerialNumber

        define IRequestHandle* Identify(void* Buffer) {
            Request* R := Alloc(#Request)

            R->Direction := TransferDirection::DeviceToHost
            R->Command := ATA::Command::IDENTIFY_DEVICE

            R->DataBuffer := Buffer
            R->DataSize := 512

            return this->Controller->SendRequest(this->Port, R)
        }

        define void DecodeIdentityString(i8* In, i32 Size, i8* Out) {
            for (i32 CopyIndex := 0, CopyIndex < Size, CopyIndex += 2) {
                Out[CopyIndex] := In[CopyIndex + 1]
                Out[CopyIndex + 1] := In[CopyIndex]
            }
            
            Out[Size] := 0
            
            for (i32 Index := Size - 1, Index >= 0, Index--) {
                if (Out[Index] = ' ') {
                    Out[Index] := 0
                }
                else {
                    break
                }
            }
        }

        define void New(IController* Controller, i32 Port) {
            this->Controller := Controller
            this->Port := Port

            this->CurrentRequest := this->Identify(this->IdentifyBuffer)
        }

        define void CompleteIdentify() {
            ;Print("Identify space:\n%hexdump\n", this->IdentifyBuffer, 512)

            this->DecodeIdentityString(this->IdentifyData.Model, 40, this->Model)
            this->DecodeIdentityString(this->IdentifyData.SerialNumber, 20, this->SerialNumber)

            ;Print("SATA Device on port %i: Model: %s, Serial: %s\n", this->Port, this->Model, this->SerialNumber)

            this->State := DeviceState::Ready
        }

        define i8 Poll(i32 Timeout) {
            if (this->CurrentRequest = null) {
                return false
            }

            if (this->CurrentRequest->Poll(Timeout)) {
                this->CurrentRequest->Free()

                if (this->State = DeviceState::Identifying) {
                    this->CompleteIdentify()
                }

                return true
            }

            return false
        }

        define i32 GetBlockSize() {
            return 512
        }

        define IRequestHandle* AsynchronousRead(i64 Block, i64 Count, void* Buffer) {
            Request* R := Alloc(#Request)

            R->Direction := TransferDirection::DeviceToHost
            R->Command := ATA::Command::READ_DMA_EXT

            R->DeviceLocation := Block
            R->BlockCount := Count As i32

            R->DataBuffer := Buffer
            R->DataSize := (Count * 512) As i32

            return this->Controller->SendRequest(this->Port, R)
        }

        define void Read(i64 Block, i64 Count, void* Buffer) {
            ;Print("Read Started %i, %i, %x\n", Block, Count, Buffer)

            this->AsynchronousRead(Block, Count, Buffer)->Wait()->Free()

            ;Print("Read Completed %i, %i, %x\n", Block, Count, Buffer)
        }

        define IRequestHandle* AsynchronousWrite(i64 Block, i64 Count, void* Buffer) {
            Request* R := Alloc(#Request)

            R->Direction := TransferDirection::HostToDevice
            R->Command := ATA::Command::WRITE_DMA_EXT

            R->DeviceLocation := Block
            R->BlockCount := Count As i32

            R->DataBuffer := Buffer
            R->DataSize := (Count * 512) As i32

            return this->Controller->SendRequest(this->Port, R)
        }
        define void Write(i64 Block, i64 Count, void* Buffer) {
            this->AsynchronousWrite(Block, Count, Buffer)->Wait()->Free()
        }
    }

    namespace FIS {
        enum Type As i8 {
            HostToDevice := 0x27
            DeviceToHost := 0x34
            ActivateDMA := 0x39
            SetupDMA := 0x41
            Data := 0x46
            SelfTest := 0x58
            SetupPIO := 0x5F
            SetDeviceBits := 0xA1
        }

        enum CommandControl {
            Control := 0,
            Command := 1
        }

        struct SetDeviceRegisters {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier
                CommandControl [7] CommandOrControl
            }

            ATA::Command Command
            i8 FeatureLow

            ; DWORD1

            bits as i32 {
                [0:23] LBALow
                [24:31] Device
            }

            ; DWORD2

            bits as i32 {
                [0:23] LBAHigh
                [24:31] FeatureHigh
            }

            ; DWORD3

            i16 Count
            i8 IsochronousCommandCompletion
            i8 Control

            ; DWORD4

            i32 _

            define void SetLBA(i64 Block) {
                this->LBALow := (Block & 0xFF_FF_FF) As i32
                this->LBAHigh := ((Block >> 24) & 0xFF_FF_FF) As i32
            }
        }

        struct GetDeviceRegisters {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier
                [5] InterruptBit
            }

            i8 Status
            i8 Error

            ; DWORD1

            bits as i32 {
                [0:23] LBALow
                [24:31] Device
            }

            ; DWORD2

            bits as i32 {
                [0:23] LBAHigh
            }

            ; DWORD3

            i16 Count
            i16 _

            ; DWORD4

            i32 _
        }

        struct Data {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier
            }

            i16 _

            ; DWORD1 - N
            i32[0] Data
        }

        struct PIOSetup {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier
                [5] TransferDirection
                [6] InterruptBit
            }

            i8 Status
            i8 Error

            ; DWORD1

            bits as i32 {
                [0:23] LBALow
                [24:31] Device
            }

            ; DWORD2

            bits as i32 {
                [0:23] LBAHigh
            }

            ; DWORD3

            i16 Count
            i8 _
            i8 NewStatus

            ; DWORD4

            i16 TransferCount
            i16 _
        }

        struct DMASetup {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier
                [5] TransferDirection
                [6] InterruptBit
                [7] AutoActivate
            }

            i16 _

            ; DWORD1 + DWORD2

            i32 DMABufferIDLow
            i32 DMABufferIDHigh

            ; DWORD3

            i32 _

            ; DWORD4

            i32 DMABufferOffset

            ; DWORD5

            i32 TransferCount

            ; DWORD6

            i32 _
        }

        struct SetDeviceBits {
            ; DWORD0

            Type Type

            bits as i8 {
                [0:3] PortMultiplier

                [6] InterruptPending
                [7] NotificationPending
            }

            bits as i8 {
                [0:2] StatusLow
                [4:6] StatusHigh
            }

            i8 Error

            ; DWORD1

            i32 _
        }

        struct ReceivedFIS {
            ; 0x0 - 0x20

            DMASetup DMA
            i8[4] _

            PIOSetup PIO
            i32[12] _
        }
    }
}