#Require "./src/drivers/block-device/BlockDevice.rlx"
#Require "$/File.rlx"

class FileBlockDevice implements IBlockDevice, derives INew {
	i64 Handle
	i32 BlockSize

	define void New(i64 Handle, i32 BlockSize) {
		this->Handle := Handle
		this->BlockSize := BlockSize
	}
	
	define void Read(i64 FirstBlock, i64 BlockCount, void* Buffer) {
		FileSeek(this->Handle, (FirstBlock * this->BlockSize) As i32, SEEK_SET)
		FileRead(this->Handle, Buffer, (BlockCount * this->BlockSize) As i32)
	}
	define void Write(i64 FirstBlock, i64 BlockCount, void* Buffer) {
		FileSeek(this->Handle, (FirstBlock * this->BlockSize) As i32, SEEK_SET)
		FileWrite(this->Handle, Buffer, (BlockCount * this->BlockSize) As i32)
	}
	define i64 GetBlockSize() {
		return this->BlockSize
	}
}
