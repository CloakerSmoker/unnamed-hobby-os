#Require "./src/drivers/GPT.rlx"
#Require "$/StringBase.rlx"

class GPTPartitionBlockDevice implements IBlockDevice, derives INew {
	GPTDevice* Parent
	IBlockDevice* Base

	GPTPartitionEntry Entry
	i32 PartitionNumber

	define void New(GPTDevice* Parent, i32 PartitionNumber) {
		this->Parent := Parent
		this->Base := Parent->Device

		this->PartitionNumber := PartitionNumber
		
		MoveMemory(this~>Entry, Parent->ReadPartitionEntry(PartitionNumber), #GPTPartitionEntry)
	}
	
	define void Read(i64 FirstBlock, i64 BlockCount, void* Buffer) {
		if (FirstBlock + BlockCount >= this~>Entry->EndingLBA) {
			Print("Read %i + %i, end = %i\n", FirstBlock, BlockCount, this~>Entry->EndingLBA)
			Throw(BLOCK_DEVICE_READ_PAST_END)
		}
		
		this->Base->Read(this~>Entry->StartingLBA + FirstBlock, BlockCount, Buffer)
	}

	define void Write(i64 FirstBlock, i64 BlockCount, void* Buffer) {
		if (FirstBlock + BlockCount >= this~>Entry->EndingLBA) {
			Print("Write %i + %i, end = %i\n", FirstBlock, BlockCount, this~>Entry->EndingLBA)
			Throw(BLOCK_DEVICE_WRITE_PAST_END)
		}
		
		this->Base->Write(this~>Entry->StartingLBA + FirstBlock, BlockCount, Buffer)
	}
	
	define i64 GetBlockSize() {
		return 0x200
	}
}
