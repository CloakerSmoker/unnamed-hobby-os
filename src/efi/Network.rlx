    NOT_DEFINED := 0
    FILE_NOT_FOUND := 1
    ACCESS_VIOLATION := 2
    DISK_FULL := 3
    ILLEGAL_OPERATION := 4
    UNKNOWN_TRANSFER_ID := 5
    FILE_ALREADY_EXISTS := 6
    NO_SUCH_USER := 7
    REQUEST_DENIED := 8
}

struct EFI_MTFTP4_ERROR_HEADER {
