}

struct EFI_MTFTP4_PACKETE {
    union {
        EFI_MTFTP4_OPCODE Opcode
        EFI_MTFTP4_REQUEST_HEADER ReadRequest
        EFI_MTFTP4_REQUEST_HEADER WriteRequest
        EFI_MTFTP4_OACK_HEADER Oack
        EFI_MTFTP4_DATA_HEADER Data
        EFI_MTFTP4_ACK_HEADER Ack
        EFI_MTFTP4_DATA8_HEADER Data8
        EFI_MTFTP4_ACK8_HEADER Ack8
        EFI_MTFTP4_ERROR_HEADER Error
    }
}

struct EFI_MTFTP4_TOKEN {
    EFI_STATUS Status
    EFI_EVENT* Event

    EFI_MTFTP4_OVERRIDE_DATA* Override

    i8* FileName
    i8* Mode

    i32 OptionCount
    EFI_MTFTP4_OPTION* Options

    i64 BufferSize
    void* Buffer

    void* Context

    void* CheckPacketCallback
    void* TimeoutCallback
    void* PacketNeededCallback
}

i8 MTFTP4_READFILE_COMPLETED := false

define void MTFTP4OnReadFileComplete(EFI_EVENT* Event, void* Context) {
    MTFTP4_READFILE_COMPLETED := true
}

struct EFI_MTFTP4_PROTOCOL {
    void* _GetModeData
    void* _Configure
    void* _GetInfo
    void* _ParseOptions
    void* _ReadFile
    void* _WriteFile
    void* _ReadDirectory
    void* _Poll

    define EFI_STATUS GetModeData(EFI_MTFTP4_MODE_DATA* ModeData) {
        return EFICall(this, ModeData As void*, this->_GetModeData) As EFI_STATUS
    }

    define EFI_STATUS Configure(EFI_MTFTP4_CONFIG_DATA* ConfigData) {
        return EFICall(this, ConfigData As void*, this->_Configure) As EFI_STATUS
    }

    define EFI_STATUS ReadFile(EFI_MTFTP4_TOKEN* Token) {
        return EFICall(this, Token As void*, this->_ReadFile) As EFI_STATUS
    }

    define EFI_STATUS Poll() {
        return EFICall(this, this->_Poll) As EFI_STATUS
    }

    define EFI_STATUS ReadFile(i8* FileName, i8* Mode, void** OutBuffer, i32* OutSize) {
        Print("MTFTP4: Reading file: %s\n", FileName)

        EFI_MTFTP4_TOKEN* Token := Alloc(#EFI_MTFTP4_TOKEN)

        Token->FileName := FileName
        Token->Mode := Mode

        Token->BufferSize := 0x30_0000 ; 3mb maximum
        Token->Buffer := Alloc(Token->BufferSize)

        MTFTP4_READFILE_COMPLETED := false
        Token->Event := SYSTEM_TABLE->BootServices->CreateEvent(EFI_EVENT_NOTIFY_SIGNAL, EFI_TPL_CALLBACK, &MTFTP4OnReadFileComplete, this)

        EFI_STATUS Status := this->ReadFile(Token)

        if (Status != EFI_STATUS_SUCCESS) {
            Print("EFI_MTFTP4_PROTOCOL->ReadFile() failed: %s\n", nameof:(Status))
            return Status
        }

        loop {
            this->Poll()

            if (MTFTP4_READFILE_COMPLETED) {
                break
            }
        }

        SYSTEM_TABLE->BootServices->CloseEvent(Token->Event)

        if (Token->Status != EFI_STATUS_SUCCESS) {
            return Token->Status
        }

        OutSize[0] := Token->BufferSize As i32
        OutBuffer[0] := Token->Buffer

        Free(Token)

        return EFI_STATUS_SUCCESS
    }
}


