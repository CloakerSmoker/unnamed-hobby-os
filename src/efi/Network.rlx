EFI_GUID* EFI_HTTP_PROTOCOL_GUID := i8[0x9B, 0xB2, 0x59, 0x7A, 0x0B, 0x91, 0x71, 0x41, 0x82, 0x42, 0xA8, 0x5A, 0x0D, 0xF2, 0x5B, 0x5B] As EFI_GUID*

enum EFI_HTTP_VERSION {
    HTTP_1_0,
    HTTP_1_1,
    UNSUPPORTED
}

struct EFI_HTTPv4_ACCESS_POINT unaligned {
    i8 UseDefaultAddress
    i32 LocalAddress
    i32 LocalSubnet

    i8 _
    i16 LocalPort
}

struct EFI_HTTP_CONFIG_DATA {
    EFI_HTTP_VERSION Version
    i32 TimeoutMilliseconds
    i32 LocalAddressIsIPv6

    EFI_HTTPv4_ACCESS_POINT* AccessPointV4
}

enum EFI_HTTP_METHOD {
    GET
    POST
    PATCH
    OPTIONS
    CONNECT
    HEAD
    PUT
    DELETE
    TRACE
}

struct EFI_HTTP_REQUEST_DATA {
    EFI_HTTP_METHOD Method
    i16* URL
}

struct EFI_HTTP_RESPONSE_DATA {
    i32 StatusCode
}

struct EFI_HTTP_HEADER {
    i8* FieldName
    i8* FieldValue
}

struct EFI_HTTP_MESSAGE {
    union {
        EFI_HTTP_REQUEST_DATA* Request
        EFI_HTTP_RESPONSE_DATA* Response
    }

    i64 HeaderCount
    EFI_HTTP_HEADER* Headers
    i64 BodyLength
    void* Body
}

struct EFI_HTTP_TOKEN {
    EFI_EVENT* Event
    EFI_STATUS Status
    EFI_HTTP_MESSAGE* Message
}

i8 HTTP_REQUEST_COMPLETED := false

define void HTTPOnRequestComplete(EFI_EVENT* Event, EFI_HTTP_PROTOCOL* HTTP) {
    ; UEFI signals callbacks as (Event, Context).
    HTTP_REQUEST_COMPLETED := true
}

i8 HTTP_RESPONSE_COMPLETED := false

define void HTTPOnResponseComplete(EFI_EVENT* Event, EFI_HTTP_PROTOCOL* HTTP) {
    ; UEFI signals callbacks as (Event, Context).
    HTTP_RESPONSE_COMPLETED := true
}

struct EFI_HTTP_PROTOCOL {
    void* _GetModeData
    void* _Configure
    void* _Request
    void* _Cancel
    void* _Response
    void* _Poll

    define EFI_STATUS Configure(EFI_HTTP_CONFIG_DATA* ConfigData) {
        return EFICall(this, ConfigData As void*, this->_Configure) As EFI_STATUS
    }
    define EFI_STATUS Request(EFI_HTTP_TOKEN* Token) {
        return EFICall(this, Token As void*, this->_Request) As EFI_STATUS
    }
    define EFI_STATUS Response(EFI_HTTP_TOKEN* Token) {
        return EFICall(this, Token As void*, this->_Response) As EFI_STATUS
    }

    define EFI_STATUS Poll() {
        return EFICall(this, this->_Poll) As EFI_STATUS
    }

    define i32 GET(i16* URL, void** OutBuffer, i32* OutSize) {
        ; Build REQUEST_DATA

        EFI_HTTP_REQUEST_DATA* RequestData := Alloc(#EFI_HTTP_REQUEST_DATA)
        RequestData->Method := EFI_HTTP_METHOD::GET
        RequestData->URL := URL

        Print("GET URL: %w\n", URL)

        ; Build HTTP_MESSAGE (containing REQUEST_DATA)

        EFI_HTTP_MESSAGE* RequestMessage := Alloc(#EFI_HTTP_MESSAGE)

        RequestMessage->Request := RequestData

        EFI_HTTP_HEADER* Headers := Alloc(#EFI_HTTP_HEADER)

        EFI_HTTP_HEADER* ConnectionHeader := Headers[0]
        ConnectionHeader->FieldName := "Connection"
        ConnectionHeader->FieldValue := "close"

        RequestMessage->HeaderCount := 1
        RequestMessage->Headers := Headers
        RequestMessage->BodyLength := 0
        RequestMessage->Body := null

        ; Build HTTP_TOKEN (containing HTTP_MESSAGE)

        EFI_HTTP_TOKEN* RequestToken := Alloc(#EFI_HTTP_TOKEN)

        HTTP_REQUEST_COMPLETED := false
        RequestToken->Event := SYSTEM_TABLE->BootServices->CreateEvent(EFI_EVENT_NOTIFY_SIGNAL, EFI_TPL_CALLBACK, &HTTPOnRequestComplete, this)
        RequestToken->Status := EFI_STATUS_SUCCESS
        RequestToken->Message := RequestMessage

        ; Send the request and wait for it to be sent

        EFI_STATUS RequestStatus := this->Request(RequestToken)

        if (RequestStatus != EFI_STATUS_SUCCESS) {
            Print("HTTP Request() failed: %s\n", nameof:(RequestStatus))
            return -1
        }

        loop {
            this->Poll()

            if (HTTP_REQUEST_COMPLETED) {
                break
            }
        }

        ; Build HTTP_RESPONSE_DATA (for the response)
        EFI_HTTP_RESPONSE_DATA* ResponseData := Alloc(#EFI_HTTP_RESPONSE_DATA)

        ; Build HTTP_MESSAGE (for the response)

        EFI_HTTP_MESSAGE* ResponseMessage := Alloc(#EFI_HTTP_MESSAGE)
        ResponseMessage->Response := ResponseData
        ResponseMessage->HeaderCount := 0
        ResponseMessage->Headers := null

        ; Allocate a buffer for the response body (1mb maximum) and set it in the response message

        void* Buffer := Alloc(0x30_0000)

        ResponseMessage->BodyLength := 0x30_0000 ; 3mb maximum
        ResponseMessage->Body := Buffer

        ; Build the HTTP_TOKEN (for the response) and wait for the response to be received

        EFI_HTTP_TOKEN* ResponseToken := Alloc(#EFI_HTTP_TOKEN)

        HTTP_RESPONSE_COMPLETED := false
        ResponseToken->Event := SYSTEM_TABLE->BootServices->CreateEvent(EFI_EVENT_NOTIFY_SIGNAL, EFI_TPL_CALLBACK, &HTTPOnResponseComplete, this)
        ResponseToken->Status := EFI_STATUS_SUCCESS
        ResponseToken->Message := ResponseMessage

        EFI_STATUS ResponseStatus := this->Response(ResponseToken)

        if (ResponseStatus != EFI_STATUS_SUCCESS) {
            Print("HTTP Response() failed: %s\n", nameof:(ResponseStatus))
            return -1
        }

        loop {
            this->Poll()

            if (HTTP_RESPONSE_COMPLETED) {
                break
            }
        }

        i32 HeaderCount := ResponseMessage->HeaderCount As i32

        i32 ContentLength := 0

        for (i32 Index := 0, Index < HeaderCount, Index++) {
            EFI_HTTP_HEADER* Header := ResponseMessage->Headers[Index]

            Print("Response Header %i: %s: %s\n", Index, Header->FieldName, Header->FieldValue)

            if (StringEquals(Header->FieldName, "Content-Length")) {
                ContentLength := AToI(Header->FieldValue) As i32
            }
        }

        Print("Content-Length: %i (%x)\n", ContentLength, ContentLength)
        Print("First Chunk: %x\n\n", ResponseMessage->BodyLength, ResponseMessage->BodyLength)

        i32 Downloaded := ResponseMessage->BodyLength As i32

        while (Downloaded < ContentLength) {
            ResponseMessage->Response := null

            if (ResponseMessage->Headers) {
                SYSTEM_TABLE->BootServices->FreePool(ResponseMessage->Headers)
            }

            ResponseMessage->HeaderCount := 0
            ResponseMessage->BodyLength := 0x30_0000 - Downloaded ; 3mb maximum
            ResponseMessage->Body := Buffer + Downloaded

            HTTP_RESPONSE_COMPLETED := false
            EFI_STATUS ResponseStatus := this->Response(ResponseToken)

            if (ResponseStatus != EFI_STATUS_SUCCESS) {
                Print("HTTP Response() failed: %s\n", nameof:(ResponseStatus))
                loop {}
            }

            loop {
                this->Poll()

                if (HTTP_RESPONSE_COMPLETED) {
                    break
                }
            }
            
            Downloaded += ResponseMessage->BodyLength As i32

            Print("%i / %i", Downloaded, ContentLength)
            PrintCharacter(0xD)
        }

        Print("\n")

        Print("Downloaded all %i bytes\n", Downloaded)

        ; Return the response body and size

        OutSize[0] := ContentLength
        OutBuffer[0] := Buffer

        i32 Result := ResponseData->StatusCode

        SYSTEM_TABLE->BootServices->CloseEvent(ResponseToken->Event)
        Free(ResponseToken)
        Free(ResponseData)
        Free(ResponseMessage)

        SYSTEM_TABLE->BootServices->CloseEvent(RequestToken->Event)
        Free(RequestToken)
        Free(RequestData)
        Free(Headers)
        Free(RequestMessage)

        return Result
    }
}

